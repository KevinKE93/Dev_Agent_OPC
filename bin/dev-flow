#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PACK="$ROOT/dev-agent"
LIB="$PACK/lib/dev-flow"
TEMPLATES="$PACK/templates/project"

if [[ -f "$LIB/constants.sh" ]]; then
  # shellcheck source=/dev/null
  source "$LIB/constants.sh"
fi
if [[ -f "$LIB/templates.sh" ]]; then
  # shellcheck source=/dev/null
  source "$LIB/templates.sh"
fi

usage() {
  cat <<'EOF'
Usage:
  bin/dev-flow list
  bin/dev-flow manifest
  bin/dev-flow show <alias-or-skill>
  bin/dev-flow path <alias-or-skill>
  bin/dev-flow command <dev|dev-agent|idea|spec|design|figma-design|figma-library|plan|build|qa|ship|debug|ui|api|security|code-simplify>
  bin/dev-flow agent <code-reviewer|product-designer|technical-steward|test-engineer|security-auditor|ui-quality-reviewer>
  bin/dev-flow refs
  bin/dev-flow install <codex|claude-code|gemini|openclaw|opencode> [--scope project|user] [--dest path] [--mode native|full]
  bin/dev-flow uninstall <codex|claude-code|gemini|openclaw|opencode> [--scope project|user] [--dest path]
  bin/dev-flow init <project-name> [--type ui|agent|api|library|docs]
  bin/dev-flow status <project-name>
  bin/dev-flow phase <project-name> <idea|spec|design|build|qa|ship> [task] [--force]
  bin/dev-flow next <project-name> [--brief|--phase-brief|--full]
  bin/dev-flow plan <project-name>
  bin/dev-flow task <project-name> <next|start|done|block> [task-id] [reason]
  bin/dev-flow verify-phase <project-name> <idea|spec|design|build|qa|ship>
  bin/dev-flow env-check <project-name>
  bin/dev-flow ship-check <project-name>
  bin/dev-flow doctor <project-name>
  bin/dev-flow migrate <project-name> [--type ui|agent|api|library|docs]
  bin/dev-flow autonomy <project-name>
  bin/dev-flow delegate <project-name>
  bin/dev-flow ui-polish <project-name>
  bin/dev-flow reference-check <project-name> [--required|--delegated]
  bin/dev-flow asset-check <project-name>
  bin/dev-flow figma-check <project-name>
  bin/dev-flow design-check <project-name> [--allow-no-reference]
  bin/dev-flow qa-check <project-name>
  bin/dev-flow visual-check <project-name>
  bin/dev-flow check <project-name>
  bin/dev-flow package-adapters [output-dir]

Aliases:
  idea      -> idea-refine
  spec      -> spec-driven-development
  design    -> design-flow
  build     -> incremental-implementation
  qa        -> optional acceptance/monkey/visual QA
  debug     -> debugging-and-error-recovery
  ui        -> frontend-ui-engineering
  api       -> api-and-interface-design
  security  -> security-and-hardening
  ship      -> shipping-and-launch

Applicability:
  Product, agent-contract, testing, and review checks are folded into spec, build, qa, and ship. Task planning is surfaced by next and plan.
  Optional gates are controlled by <project-name>/dev-agent/state/applicability.env.
  Set AGENT_CONTRACT, UI_FLOW, UI_REFERENCES, UI_DESIGN_ASSETS, UI_FIGMA_HANDOFF, AUTOMATED_QA, VISUAL_QA, SHIP_FLOW, AUTONOMY_LOOP, AUTONOMY_TASK_MODE, AUTONOMY_HEARTBEAT_ON_TASK_LIST, AUTONOMY_BATCH_POLICY, or SUBAGENTS to auto, required, delegated, suggest, enabled, or disabled as supported.
  Project type is recorded in <project-name>/dev-agent/state/schema.env.
EOF
}

PROCESS_DIR="dev-agent"
NEW_CONTROL_DIR=".dev-agent"
LEGACY_CONTROL_DIR=".dev-flow"

project_workspace_root() {
  local project="$1"
  local cwd base
  if [[ -n "${DEV_FLOW_WORKSPACE_ROOT:-}" ]]; then
    if ! base="$(cd "$DEV_FLOW_WORKSPACE_ROOT" 2>/dev/null && pwd -P)"; then
      echo "Invalid DEV_FLOW_WORKSPACE_ROOT: $DEV_FLOW_WORKSPACE_ROOT" >&2
      exit 1
    fi
    echo "$base"
    return
  fi
  cwd="$(pwd -P)"
  base="$cwd"
  while :; do
    if [[ -d "$base/$project" || -d "$base/work/$project" ]]; then
      echo "$base"
      return
    fi
    [[ "$base" == "/" ]] && break
    base="$(dirname "$base")"
  done
  case "$cwd" in
    "$ROOT"|"$ROOT"/*) echo "$ROOT" ;;
    *) echo "$cwd" ;;
  esac
}

project_path() {
  local name="${1:-}"
  local workspace
  if [[ -z "$name" || "$name" == *"/"* || "$name" == "." || "$name" == ".." ]]; then
    echo "Invalid project name: ${name:-<missing>}" >&2
    echo "Use a simple folder name, for example: hotel-agent-workbench" >&2
    exit 1
  fi
  workspace="$(project_workspace_root "$name")"
  if [[ -d "$workspace/$name" ]]; then
    echo "$workspace/$name"
    return
  fi
  if [[ -d "$workspace/work/$name" ]]; then
    echo "$workspace/work/$name"
    return
  fi
  echo "$workspace/$name"
}

project_display_root() {
  local project="$1"
  local dir workspace
  dir="$(project_path "$project")"
  workspace="$(project_workspace_root "$project")"
  case "$dir" in
    "$workspace"/*) echo "${dir#"$workspace"/}" ;;
    *) echo "$dir" ;;
  esac
}

project_has_new_layout() {
  local dir
  dir="$(project_path "${1:-}")"
  [[ -d "$dir/$PROCESS_DIR" && -d "$dir/$NEW_CONTROL_DIR/bin" ]]
}

project_has_runtime_pack_dir_from_dir() {
  local dir="$1"
  [[ -f "$dir/$PROCESS_DIR/dev-agent.manifest.json" ]] && return 0
  [[ -d "$dir/$PROCESS_DIR/commands" && -d "$dir/$PROCESS_DIR/skills" && -d "$dir/$PROCESS_DIR/templates" ]]
}

project_has_visible_process_root_from_dir() {
  local dir="$1"
  local rel
  [[ -d "$dir/$PROCESS_DIR/state" || -f "$dir/$PROCESS_DIR/context.md" || -f "$dir/$PROCESS_DIR/HOST_REQUIREMENTS.md" ]] && return 0
  for rel in ideas product specs agent design tasks reviews ship; do
    [[ -d "$dir/$PROCESS_DIR/$rel" ]] && return 0
  done
  return 1
}

project_has_hidden_process_root_from_dir() {
  local dir="$1"
  local rel
  [[ -d "$dir/$NEW_CONTROL_DIR/state" || -f "$dir/$NEW_CONTROL_DIR/context.md" || -f "$dir/$NEW_CONTROL_DIR/HOST_REQUIREMENTS.md" ]] && return 0
  for rel in ideas product specs agent design tasks reviews ship; do
    [[ -d "$dir/$NEW_CONTROL_DIR/$rel" ]] && return 0
  done
  return 1
}

project_default_process_root_from_dir() {
  local dir="$1"
  if project_has_runtime_pack_dir_from_dir "$dir"; then
    echo "$dir/$NEW_CONTROL_DIR"
    return
  fi
  echo "$dir/$PROCESS_DIR"
}

project_has_legacy_process_dirs_from_dir() {
  local dir="$1"
  local rel
  for rel in ideas product specs agent design tasks reviews ship; do
    [[ -d "$dir/$rel" ]] && return 0
  done
  return 1
}

project_control_path() {
  local dir
  dir="$(project_path "${1:-}")"
  if [[ -d "$dir/$NEW_CONTROL_DIR" ]]; then
    echo "$dir/$NEW_CONTROL_DIR"
    return
  fi
  if [[ -d "$dir/$LEGACY_CONTROL_DIR" ]]; then
    echo "$dir/$LEGACY_CONTROL_DIR"
    return
  fi
  echo "$dir/$NEW_CONTROL_DIR"
}

project_control_path_from_dir() {
  local dir="$1"
  if [[ -d "$dir/$NEW_CONTROL_DIR" ]]; then
    echo "$dir/$NEW_CONTROL_DIR"
    return
  fi
  if [[ -d "$dir/$LEGACY_CONTROL_DIR" ]]; then
    echo "$dir/$LEGACY_CONTROL_DIR"
    return
  fi
  echo "$dir/$NEW_CONTROL_DIR"
}

project_process_root() {
  local dir
  dir="$(project_path "${1:-}")"
  if project_has_visible_process_root_from_dir "$dir"; then
    echo "$dir/$PROCESS_DIR"
    return
  fi
  if project_has_hidden_process_root_from_dir "$dir"; then
    echo "$dir/$NEW_CONTROL_DIR"
    return
  fi
  if [[ -d "$dir/$LEGACY_CONTROL_DIR" ]] || project_has_legacy_process_dirs_from_dir "$dir"; then
    echo "$dir"
    return
  fi
  project_default_process_root_from_dir "$dir"
}

ensure_control_for_uninitialized_project() {
  local project="$1"
  local dir project_type
  dir="$(project_path "$project")"
  project_has_visible_process_root_from_dir "$dir" && return 0
  project_has_hidden_process_root_from_dir "$dir" && return 0
  [[ -d "$dir/$LEGACY_CONTROL_DIR" ]] && return 0
  project_has_legacy_process_dirs_from_dir "$dir" && return 0
  project_type="${DEV_FLOW_DEFAULT_PROJECT_TYPE:-ui}"
  if ! dev_flow_valid_project_type "$project_type"; then
    project_type="ui"
  fi
  ensure_project_dirs "$dir"
  write_project_templates "$dir" "$project" "$project_type"
}

project_process_root_from_dir() {
  local dir="$1"
  if project_has_visible_process_root_from_dir "$dir"; then
    echo "$dir/$PROCESS_DIR"
    return
  fi
  if project_has_hidden_process_root_from_dir "$dir"; then
    echo "$dir/$NEW_CONTROL_DIR"
    return
  fi
  if [[ -d "$dir/$LEGACY_CONTROL_DIR" ]] || project_has_legacy_process_dirs_from_dir "$dir"; then
    echo "$dir"
    return
  fi
  project_default_process_root_from_dir "$dir"
}

source_root_for_process_dir() {
  local dir="$1"
  case "$dir" in
    */"$PROCESS_DIR") dirname "$dir" ;;
    */"$NEW_CONTROL_DIR") dirname "$dir" ;;
    *) echo "$dir" ;;
  esac
}

project_control_display_root() {
  local project="$1"
  local project_root control_root workspace display_root
  project_root="$(project_path "$project")"
  control_root="$(project_control_path "$project")"
  workspace="$(project_workspace_root "$project")"
  case "$project_root" in
    "$workspace"/*) display_root="${project_root#"$workspace"/}" ;;
    *) display_root="$project_root" ;;
  esac
  case "$control_root" in
    "$project_root/$NEW_CONTROL_DIR") echo "$display_root/$NEW_CONTROL_DIR" ;;
    "$project_root/$LEGACY_CONTROL_DIR") echo "$display_root/$LEGACY_CONTROL_DIR" ;;
    *) echo "$control_root" ;;
  esac
}

project_process_display_root() {
  local project="$1"
  local process_root project_root workspace display_root
  project_root="$(project_path "$project")"
  process_root="$(project_process_root "$project")"
  workspace="$(project_workspace_root "$project")"
  case "$project_root" in
    "$workspace"/*) display_root="${project_root#"$workspace"/}" ;;
    *) display_root="$project_root" ;;
  esac
  if [[ "$process_root" == "$project_root/$NEW_CONTROL_DIR" ]]; then
    project_control_display_root "$project"
    return
  fi
  if [[ "$process_root" == "$project_root/$PROCESS_DIR" ]]; then
    echo "$display_root/$PROCESS_DIR"
    return
  fi
  project_display_root "$project"
}

project_check_path() {
  local project="$1"
  local root control
  root="$(project_path "$project")"
  control="$(project_control_path "$project")"
  if [[ "$control" == "$root/$NEW_CONTROL_DIR" ]]; then
    echo "$control/bin/check"
  else
    echo "$root/bin/check"
  fi
}

state_path() {
  local dir control process_root
  dir="$(project_path "${1:-}")"
  control="$(project_control_path "${1:-}")"
  process_root="$(project_process_root "${1:-}")"
  if [[ "$control" == "$dir/$LEGACY_CONTROL_DIR" && "$process_root" == "$dir" ]]; then
    echo "$control/state.env"
  else
    echo "$process_root/state/state.env"
  fi
}

schema_path() {
  local dir control process_root
  dir="$(project_path "${1:-}")"
  control="$(project_control_path "${1:-}")"
  process_root="$(project_process_root "${1:-}")"
  if [[ "$control" == "$dir/$LEGACY_CONTROL_DIR" && "$process_root" == "$dir" ]]; then
    echo "$control/schema.env"
  else
    echo "$process_root/state/schema.env"
  fi
}

applicability_path() {
  local dir control process_root
  dir="$(project_path "${1:-}")"
  control="$(project_control_path "${1:-}")"
  process_root="$(project_process_root "${1:-}")"
  if [[ "$control" == "$dir/$LEGACY_CONTROL_DIR" && "$process_root" == "$dir" ]]; then
    echo "$control/applicability.env"
  else
    echo "$process_root/state/applicability.env"
  fi
}

autonomy_path() {
  local dir control process_root
  dir="$(project_path "${1:-}")"
  control="$(project_control_path "${1:-}")"
  process_root="$(project_process_root "${1:-}")"
  if [[ "$control" == "$dir/$LEGACY_CONTROL_DIR" && "$process_root" == "$dir" ]]; then
    echo "$control/autonomy.env"
  else
    echo "$process_root/state/autonomy.env"
  fi
}

tasks_path() {
  local dir
  dir="$(project_process_root "${1:-}")"
  echo "$dir/tasks/TASKS.md"
}

execution_plan_path() {
  local dir
  dir="$(project_process_root "${1:-}")"
  echo "$dir/tasks/EXECUTION_PLAN.md"
}

require_project() {
  local dir
  dir="$(project_path "${1:-}")"
  if [[ ! -d "$dir" ]]; then
    echo "Unknown project: ${1:-<missing>}" >&2
    echo "Create it first with: bin/dev-flow init <project-name>" >&2
    exit 1
  fi
}

load_project_state() {
  local state
  state="$(state_path "${1:-}")"
  if [[ -f "$state" ]]; then
    # shellcheck disable=SC1090
    source "$state"
  fi
  CURRENT_PHASE="${CURRENT_PHASE:-idea}"
  CURRENT_TASK="${CURRENT_TASK:-Refine the initial idea}"
  BLOCKERS="${BLOCKERS:-none}"
  LAST_VERIFICATION="${LAST_VERIFICATION:-not run}"
}

load_project_schema() {
  local schema
  schema="$(schema_path "${1:-}")"
  PROJECT_SCHEMA_VERSION="${PROJECT_SCHEMA_VERSION:-1}"
  PROJECT_TYPE="${PROJECT_TYPE:-ui}"
  if [[ -f "$schema" ]]; then
    # shellcheck disable=SC1090
    source "$schema"
  fi
  PROJECT_SCHEMA_VERSION="${PROJECT_SCHEMA_VERSION:-1}"
  PROJECT_TYPE="${PROJECT_TYPE:-ui}"
}

project_type_from_options() {
  local project_type="ui"
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --type)
        project_type="${2:-}"
        shift 2
        ;;
      --type=*)
        project_type="${1#--type=}"
        shift
        ;;
      *)
        echo "Unknown option: $1" >&2
        usage >&2
        exit 1
        ;;
    esac
  done
  if ! dev_flow_valid_project_type "$project_type"; then
    echo "Invalid project type: ${project_type:-<missing>}" >&2
    echo "Use one of: ui, agent, api, library, docs." >&2
    exit 1
  fi
  echo "$project_type"
}

is_valid_phase() {
  case "${1:-}" in
    idea|spec|design|build|qa|ship) return 0 ;;
    *) return 1 ;;
  esac
}

write_project_state() {
  local project="$1"
  local phase="$2"
  local task="$3"
  local blockers="$4"
  local verification="$5"
  local state
  state="$(state_path "$project")"
  mkdir -p "$(dirname "$state")"
  {
    printf 'PROJECT_NAME=%q\n' "$project"
    printf 'CURRENT_PHASE=%q\n' "$phase"
    printf 'CURRENT_TASK=%q\n' "$task"
    printf 'BLOCKERS=%q\n' "$blockers"
    printf 'LAST_VERIFICATION=%q\n' "$verification"
  } > "$state"
}

write_project_schema_file() {
  local project="$1"
  local project_type="$2"
  local schema
  schema="$(schema_path "$project")"
  mkdir -p "$(dirname "$schema")"
  {
    printf 'PROJECT_SCHEMA_VERSION="%s"\n' "$DEV_FLOW_PROJECT_SCHEMA_VERSION"
    printf 'PROJECT_TYPE="%s"\n' "$project_type"
  } > "$schema"
}

write_if_missing() {
  local path="$1"
  local content="$2"
  if [[ ! -e "$path" ]]; then
    mkdir -p "$(dirname "$path")"
    printf '%s\n' "$content" > "$path"
  fi
}

ensure_project_dirs() {
  local dir="$1"
  local process_root
  process_root="$(project_default_process_root_from_dir "$dir")"
  mkdir -p "$process_root/state" "$dir/$NEW_CONTROL_DIR/bin"
}

ensure_design_dirs() {
  local dir="$1"
  mkdir -p "$dir/design"/{references,drafts,mocks,screenshots,sources,approved,cut-assets}
  mkdir -p "$dir/design/sources"/{imagegen,gpt-image,figma,html}
  mkdir -p "$dir/design/approved"/{screens,components,html}
  mkdir -p "$dir/design/cut-assets"/{icons,sprites,illustrations,backgrounds}
}

write_project_template() {
  local dir="$1"
  local rel="$2"
  local template="$3"
  local project="$4"
  local project_type="$5"
  if [[ ! -f "$TEMPLATES/$template" ]]; then
    echo "Missing project template: $TEMPLATES/$template" >&2
    exit 1
  fi
  dev_flow_write_template_if_missing "$dir/$rel" "$TEMPLATES/$template" "$project" "$project_type"
}

write_project_templates() {
  local dir="$1"
  local project="$2"
  local project_type="$3"
  local control_rel process_rel process_root
  local app_template
  app_template="$(dev_flow_applicability_template_for_type "$project_type")"
  [[ -n "$app_template" ]] || { echo "Unsupported project type: $project_type" >&2; exit 1; }
  if [[ -d "$dir/$NEW_CONTROL_DIR" || ! -d "$dir/$LEGACY_CONTROL_DIR" ]]; then
    control_rel="$NEW_CONTROL_DIR"
    process_root="$(project_default_process_root_from_dir "$dir")"
    process_rel="${process_root#"$dir"/}"
    write_project_template "$dir" "$process_rel/state/schema.env" "schema.env" "$project" "$project_type"
    write_project_template "$dir" "$process_rel/state/state.env" "state.env" "$project" "$project_type"
    write_project_template "$dir" "$process_rel/state/applicability.env" "$app_template" "$project" "$project_type"
    write_project_template "$dir" "$process_rel/context.md" "context.md" "$project" "$project_type"
    write_project_template "$dir" "$process_rel/HOST_REQUIREMENTS.md" "host-requirements.md" "$project" "$project_type"
    write_project_template "$dir" "$process_rel/state/autonomy.env" "autonomy.env" "$project" "$project_type"
    write_project_template "$dir" "$control_rel/bin/check" "check.sh" "$project" "$project_type"
    chmod +x "$dir/$control_rel/bin/check"
  else
    control_rel="$LEGACY_CONTROL_DIR"
    write_project_template "$dir" "$control_rel/schema.env" "schema.env" "$project" "$project_type"
    write_project_template "$dir" "$control_rel/state.env" "state.env" "$project" "$project_type"
    write_project_template "$dir" "$control_rel/applicability.env" "$app_template" "$project" "$project_type"
    write_project_template "$dir" "$control_rel/context.md" "context.md" "$project" "$project_type"
    write_project_template "$dir" "$control_rel/HOST_REQUIREMENTS.md" "host-requirements.md" "$project" "$project_type"
    write_project_template "$dir" "$control_rel/autonomy.env" "autonomy.env" "$project" "$project_type"
    write_project_template "$dir" "bin/check" "check.sh" "$project" "$project_type"
    chmod +x "$dir/bin/check"
  fi
}

write_design_templates() {
  local dir="$1"
  local project="$2"
  local project_type="$3"
  write_project_template "$dir" "design/reference-intake.md" "reference-intake.md" "$project" "$project_type"
  write_project_template "$dir" "design/reference-links.md" "reference-links.md" "$project" "$project_type"
  write_project_template "$dir" "design/REFERENCE_BOARD.md" "reference-board.md" "$project" "$project_type"
  write_project_template "$dir" "design/FIGMA_HANDOFF.md" "figma-handoff.md" "$project" "$project_type"
  write_project_template "$dir" "design/DESIGN.md" "design.md" "$project" "$project_type"
  write_project_template "$dir" "design/VISUAL_SYSTEM.md" "visual-system.md" "$project" "$project_type"
  write_project_template "$dir" "design/SCREEN_ACCEPTANCE.md" "screen-acceptance.md" "$project" "$project_type"
  write_project_template "$dir" "design/DESIGN_ARTIFACTS.md" "design-artifacts.md" "$project" "$project_type"
  write_project_template "$dir" "design/DESIGN_IMAGE_DESCRIPTIONS.md" "design-image-descriptions.md" "$project" "$project_type"
  write_project_template "$dir" "design/cut-assets/ASSET_MANIFEST.md" "cut-assets-manifest.md" "$project" "$project_type"
}

write_build_templates() {
  local dir="$1"
  local project="$2"
  local project_type="$3"
  write_project_template "$dir" "tasks/status.md" "status.md" "$project" "$project_type"
  write_project_template "$dir" "tasks/TASKS.md" "tasks.md" "$project" "$project_type"
  write_project_template "$dir" "tasks/EXECUTION_PLAN.md" "execution-plan.md" "$project" "$project_type"
  write_project_template "$dir" "tasks/quality-gates.md" "quality-gates.md" "$project" "$project_type"
  write_project_template "$dir" "tasks/TECHNICAL_PLAN.md" "technical-plan.md" "$project" "$project_type"
  write_project_template "$dir" "tasks/IMPLEMENTATION_TRACE.md" "implementation-trace.md" "$project" "$project_type"
  write_project_template "$dir" "tasks/AUTONOMY.md" "autonomy.md" "$project" "$project_type"
  write_project_template "$dir" "tasks/DELEGATION.md" "delegation.md" "$project" "$project_type"
  write_project_template "$dir" "tasks/subagents/TEMPLATE.md" "subagent-task.md" "$project" "$project_type"
  write_project_template "$dir" "reviews/UI_DEBT.md" "ui-debt.md" "$project" "$project_type"
}

write_qa_templates() {
  local dir="$1"
  local project="$2"
  local project_type="$3"
  write_project_template "$dir" "reviews/FUNCTIONAL_TEST.md" "functional-test.md" "$project" "$project_type"
  write_project_template "$dir" "reviews/MONKEY_TEST.md" "monkey-test.md" "$project" "$project_type"
  write_project_template "$dir" "reviews/ACCEPTANCE_QA.html" "acceptance-qa.html" "$project" "$project_type"
  write_project_template "$dir" "reviews/VISUAL_COMPARISON.md" "visual-comparison.md" "$project" "$project_type"
}

ensure_status_artifacts() {
  local dir="$1"
  local project="$2"
  local project_type="$3"
  mkdir -p "$dir/tasks"
  write_project_template "$dir" "tasks/status.md" "status.md" "$project" "$project_type"
  write_project_template "$dir" "tasks/TASKS.md" "tasks.md" "$project" "$project_type"
  write_project_template "$dir" "tasks/EXECUTION_PLAN.md" "execution-plan.md" "$project" "$project_type"
}

ensure_phase_artifacts() {
  local dir="$1"
  local project="$2"
  local project_type="$3"
  local phase="$4"
  case "$phase" in
    idea)
      mkdir -p "$dir/ideas"
      ;;
    spec)
      mkdir -p "$dir"/{ideas,product,agent,specs}
      ;;
    design)
      ensure_design_dirs "$dir"
      write_design_templates "$dir" "$project" "$project_type"
      ;;
    build)
      mkdir -p "$dir"/{tasks,reviews}
      write_build_templates "$dir" "$project" "$project_type"
      ;;
    qa)
      mkdir -p "$dir/reviews/acceptance-screenshots" "$dir/reviews/visual-screenshots"
      write_qa_templates "$dir" "$project" "$project_type"
      ;;
    ship)
      mkdir -p "$dir"/{ship,reviews}
      ;;
  esac
}

phase_default_task() {
  case "${1:-}" in
    idea) echo "Refine the initial idea" ;;
    spec) echo "Write PRD and buildable SPEC.md" ;;
    design) echo "Resolve design direction and build handoff" ;;
    build) echo "Write the technical plan, verify readiness, and implement the next slice" ;;
    qa) echo "Run optional acceptance, monkey, and visual QA for the completed build" ;;
    ship) echo "Prepare optional launch evidence and go/no-go decision" ;;
    *) echo "Continue workflow" ;;
  esac
}

next_applicable_phase_after() {
  local project="$1"
  local current="$2"
  local phase seen
  seen="false"
  for phase in idea spec design build qa ship; do
    if [[ "$seen" == "true" ]]; then
      if phase_is_applicable "$project" "$phase"; then
        echo "$phase"
        return 0
      fi
    fi
    if [[ "$phase" == "$current" ]]; then
      seen="true"
    fi
  done
  echo ""
}

phase_skill_files() {
  local project="$1"
  local phase="$2"
  case "$phase" in
    spec)
      echo "- dev-agent/skills/spec-driven-development/SKILL.md"
      if agent_contract_applies "$project"; then
        echo "- agent runtime contract sections inside SPEC.md when agent automation is in scope"
      fi
      ;;
    build)
      echo "- dev-agent/skills/incremental-implementation/SKILL.md"
      echo "- required Build technical plan before implementation"
      echo "- embedded proof-first build checklist"
      echo "- source structure discipline for feature modules and UI/component boundaries"
      if phase_is_applicable "$project" design; then
        echo "- dev-agent/skills/frontend-ui-engineering/SKILL.md"
      fi
      ;;
    qa)
      echo "- dev-agent/skills/frontend-ui-engineering/SKILL.md when UI applies"
      echo "- dev-agent/references/acceptance-qa.md"
      echo "- embedded acceptance, monkey, visual, and review checklist"
      ;;
    *)
      echo "- dev-agent/skills/$(skill_name "$phase")/SKILL.md"
      ;;
  esac
}

phase_load_list() {
  local project="$1"
  local phase="$2"
  local project_root process_root
  project_root="$(project_display_root "$project")"
  process_root="$(project_process_display_root "$project")"
  echo "- $process_root/context.md"
  echo "- dev-agent/commands/$phase.md"
  phase_skill_files "$project" "$phase"
  case "$phase" in
    idea)
      echo "- user request and existing $process_root/ideas/ notes"
      ;;
    spec)
      echo "- $process_root/ideas/idea-brief.md"
      echo "- $process_root/product/ when existing product artifacts apply"
      echo "- $process_root/agent/ legacy agent notes when present"
      echo "- existing source under $project_root/ when present"
      ;;
    design)
      echo "- $process_root/ideas/idea-brief.md"
      echo "- $process_root/product/PRD.md, USER_STORIES.md, ACCEPTANCE.md, and METRICS.md when present"
      echo "- $process_root/agent/ legacy agent artifacts when present"
      echo "- $process_root/specs/SPEC.md"
      echo "- $process_root/design/reference-intake.md"
      echo "- $process_root/design/reference-links.md"
      echo "- $process_root/design/references/ and $process_root/design/screenshots/"
      echo "- dev-agent/references/design-artifacts.md"
      echo "- dev-agent/references/figma-handoff.md when Figma is used"
      ;;
    build)
      echo "- $process_root/specs/SPEC.md"
      echo "- $process_root/tasks/TECHNICAL_PLAN.md"
      echo "- $process_root/tasks/PLAN.md when present; otherwise derive a short build slice from SPEC/design"
      echo "- $process_root/tasks/IMPLEMENTATION_TRACE.md source structure note when present"
      echo "- $process_root/HOST_REQUIREMENTS.md when the slice needs host SDKs/CLIs/services"
      echo "- assigned task and nearby source/tests under $project_root/"
      if phase_is_applicable "$project" design; then
        echo "- $process_root/tasks/IMPLEMENTATION_TRACE.md"
        if design_assets_required "$project"; then
          echo "- required design contract inputs from dev-agent/references/design-artifacts.md"
          echo "- dev-agent/references/figma-handoff.md when Figma is used"
        else
          echo "- $process_root/design/ requirement notes for non-UI/code-only context"
        fi
      fi
      ;;
    qa)
      echo "- implemented source and existing tests"
      echo "- $process_root/reviews/VERIFICATION.md or relevant command output"
      echo "- $process_root/reviews/FUNCTIONAL_TEST.md, MONKEY_TEST.md, ACCEPTANCE_QA.html, and VISUAL_COMPARISON.md when QA is required"
      ;;
    ship)
      echo "- $process_root/ship/ and $process_root/reviews/"
      echo "- final build/test/package evidence"
      ;;
  esac
}

phase_required_outputs() {
  local project="$1"
  local phase="$2"
  local process_root
  process_root="$(project_process_display_root "$project")"
  case "$phase" in
    idea)
      echo "- $process_root/ideas/idea-brief.md with lightweight requirement attribution"
      ;;
    spec)
      echo "- $process_root/product/PRD.md"
      echo "- $process_root/specs/SPEC.md"
      echo "- $process_root/specs/SPEC.md source architecture and module boundary notes when code changes apply"
      load_project_applicability "$project"
      if [[ "$PROJECT_TYPE" == "ui" ]]; then
        echo "- $process_root/product/PRD.md covers MVP scope, core flows/IA, acceptance criteria, and non-goals"
        echo "- $process_root/specs/SPEC.md covers stack, commands, data/domain model, testing, UI/design applicability, privacy/security, and open questions"
      fi
      echo "- $process_root/specs/SPEC.md Agent Runtime Contract section when agent automation is in scope"
      ;;
    design)
      echo "- $process_root/design/DESIGN.md"
      echo "- $process_root/design/VISUAL_SYSTEM.md"
      echo "- $process_root/design/SCREEN_ACCEPTANCE.md with Requirement source for every screen"
      if design_assets_required "$project"; then
        echo "- formal visual design assets and required synchronized HTML/CSS companions per dev-agent/references/design-artifacts.md"
        echo "- Figma handoff required by dev-agent/references/figma-handoff.md when Figma is used"
      else
        echo "- formal visual assets are not required only when UI_FLOW is disabled or design is not applicable"
      fi
      ;;
    build)
      echo "- $process_root/tasks/TECHNICAL_PLAN.md with platform/language decision, client/web/backend architecture applicability, state/routing/component strategy, security quality, build slice plan, and steward review decision"
      echo "- implemented source under the project root (for example src/, app/, apps/, packages/, or stack manifest files)"
      echo "- source structure note with feature/module boundary, container/presentational split, shared primitives, and proof path"
      echo "- tests or executable proof for the slice"
      echo "- $process_root/HOST_REQUIREMENTS.md updated and env-check passed when the slice used host capabilities"
      echo "- $process_root/reviews/VERIFICATION.md or command evidence for the slice"
      if phase_is_applicable "$project" design; then
        echo "- $process_root/tasks/IMPLEMENTATION_TRACE.md mapping UI screens to implementation targets and test evidence"
        if design_assets_required "$project"; then
          echo "- $process_root/tasks/IMPLEMENTATION_TRACE.md also maps required design contract inputs"
        fi
      fi
      ;;
    qa)
      echo "- $process_root/reviews/VERIFICATION.md or $process_root/reviews/BLOCKED_BUILD.md"
      if qa_required "$project"; then
        load_project_applicability "$project"
        if setting_enabled "$AUTOMATED_QA"; then
          echo "- $process_root/reviews/FUNCTIONAL_TEST.md"
          echo "- $process_root/reviews/MONKEY_TEST.md"
          echo "- $process_root/reviews/ACCEPTANCE_QA.html"
        fi
        if phase_is_applicable "$project" design && visual_qa_required "$project"; then
          echo "- $process_root/reviews/VISUAL_COMPARISON.md after the UI batch is complete"
        fi
      fi
      ;;
    ship)
      echo "- $process_root/ship/LAUNCH.md"
      echo "- rollback plan and GO/NO-GO decision"
      ;;
  esac
}

phase_gate_list() {
  local project="$1"
  local phase="$2"
  case "$phase" in
    design)
      echo "- bin/dev-flow design-check $project"
      ;;
    build)
      echo "- bin/dev-flow env-check $project before host-dependent commands in the current slice"
      echo "- bin/dev-flow verify-phase $project build"
      echo "- bin/dev-flow check $project"
      ;;
    qa)
      echo "- bin/dev-flow verify-phase $project qa"
      echo "- bin/dev-flow qa-check $project when AUTOMATED_QA or VISUAL_QA is required"
      ;;
    ship)
      echo "- bin/dev-flow ship-check $project"
      ;;
    *)
      echo "- bin/dev-flow verify-phase $project $phase"
      ;;
  esac
}

phase_blockers() {
  local project="$1"
  local phase="$2"
  case "$phase" in
    design)
      echo "- no reference assets/links and UI_REFERENCES is not delegated"
      echo "- delegated visual direction without design/REFERENCE_BOARD.md"
      echo "- unresolved UX, state, or visual-system choices that would force build to guess"
      echo "- UI_DESIGN_ASSETS=disabled while UI_FLOW remains active"
      if design_assets_required "$project"; then
        echo "- required formal design artifact contract is incomplete"
        echo "- Figma handoff contract is incomplete when Figma is used"
      fi
      ;;
    build)
      echo "- unclear task acceptance criteria"
      echo "- unclear module boundary or unrecorded monolith exception for a UI-heavy or multi-file slice"
      echo "- missing local verification command"
      echo "- required host capability for the current slice is missing or blocked"
      if phase_is_applicable "$project" design; then
        echo "- missing design-check pass before UI code"
      fi
      ;;
    qa)
      echo "- proof cannot verify the behavior"
      echo "- blocked build without reviews/BLOCKED_BUILD.md"
      ;;
    ship)
      echo "- missing rollback plan"
      echo "- failed ship-check or launch blocker review"
      ;;
    *)
      echo "- required source artifact is missing or too thin"
      echo "- assumptions, tradeoffs, or human-review blockers are unresolved"
      ;;
  esac
}

task_primary_gate_for_phase() {
  local project="$1"
  local phase="$2"
  case "$phase" in
    design) echo "bin/dev-flow design-check $project" ;;
    build) echo "bin/dev-flow verify-phase $project build && bin/dev-flow check $project" ;;
    qa) echo "bin/dev-flow verify-phase $project qa" ;;
    ship) echo "bin/dev-flow ship-check $project" ;;
    *) echo "bin/dev-flow verify-phase $project $phase" ;;
  esac
}

task_markdown_rows_count() {
  local path="$1"
  [[ -f "$path" ]] || { echo 0; return 0; }
  awk -F'|' '
    function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
    /^\|/ {
      id = trim($2)
      if (id ~ /^TASK-/) count++
    }
    END { print count + 0 }
  ' "$path"
}

task_status_count() {
  local path="$1"
  local wanted="$2"
  [[ -f "$path" ]] || { echo 0; return 0; }
  awk -F'|' -v wanted="$wanted" '
    function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
    function want(status) {
      split(wanted, values, ",")
      for (i in values) if (status == values[i]) return 1
      return 0
    }
    /^\|/ {
      id = trim($2)
      status = tolower(trim($9))
      if (id ~ /^TASK-/ && want(status)) count++
    }
    END { print count + 0 }
  ' "$path"
}

task_review_issue_count() {
  local path="$1"
  [[ -f "$path" ]] || { echo 0; return 0; }
  awk -F'|' '
    function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
    function bad(s) {
      s = tolower(trim(s))
      return s == "" || s ~ /(tbd|todo|unclear|unknown|待确认|不明确)/
    }
    /^\|/ {
      id = trim($2)
      status = tolower(trim($9))
      if (id ~ /^TASK-/ && status !~ /^(done|blocked|skipped)$/ && (bad($6) || bad($7))) count++
    }
    END { print count + 0 }
  ' "$path"
}

task_high_risk_count() {
  local path="$1"
  [[ -f "$path" ]] || { echo 0; return 0; }
  awk -F'|' '
    function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
    /^\|/ {
      id = trim($2)
      status = tolower(trim($9))
      text = tolower(trim($3) " " trim($5) " " trim($8))
      if (id ~ /^TASK-/ && status !~ /^(done|skipped)$/ && text ~ /(high|payment|billing|security|permission|credential|secret|privacy|delete|destructive|production|launch|ship|高风险|权限|隐私|删除|生产)/) count++
    }
    END { print count + 0 }
  ' "$path"
}

task_next_pending_summary() {
  local path="$1"
  [[ -f "$path" ]] || return 0
  awk -F'|' '
    function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
    /^\|/ {
      id = trim($2)
      status = tolower(trim($9))
      if (id ~ /^TASK-/ && status ~ /^(pending|planned|todo)$/) {
        print id " - " trim($3)
        exit
      }
    }
  ' "$path"
}

task_next_pending_column() {
  local path="$1"
  local column="$2"
  [[ -f "$path" ]] || return 0
  awk -F'|' -v column="$column" '
    function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
    /^\|/ {
      id = trim($2)
      status = tolower(trim($9))
      if (id ~ /^TASK-/ && status ~ /^(pending|planned|todo)$/) {
        print trim($column)
        exit
      }
    }
  ' "$path"
}

task_plan_source_label() {
  local path="$1"
  if [[ -f "$path" ]] && grep -q 'auto-generated from current phase outputs' "$path"; then
    echo "generated from current phase outputs"
  else
    echo "existing task list"
  fi
}

append_generated_task_if_needed() {
  local project="$1"
  local phase="$2"
  local path gate id title
  path="$(tasks_path "$project")"
  if [[ "$(task_markdown_rows_count "$path")" -gt 0 ]]; then
    return 0
  fi
  gate="$(task_primary_gate_for_phase "$project" "$phase")"
  id="TASK-${phase}-001"
  title="$(phase_default_task "$phase")"
  {
    echo "| $id | $title | current phase | Required outputs for phase: $phase | $gate passes | $gate | normal | pending | auto-generated from current phase outputs |"
  } >> "$path"
}

task_review_status() {
  local project="$1"
  local path blocked high_risk review_issues rows
  path="$(tasks_path "$project")"
  rows="$(task_markdown_rows_count "$path")"
  if [[ "$rows" -eq 0 ]]; then
    echo "pause"
    return 0
  fi
  blocked="$(task_status_count "$path" "blocked")"
  if [[ "$blocked" -gt 0 ]]; then
    echo "pause"
    return 0
  fi
  high_risk="$(task_high_risk_count "$path")"
  if [[ "$high_risk" -gt 0 ]] || current_task_is_high_risk_loaded; then
    echo "approval-required"
    return 0
  fi
  review_issues="$(task_review_issue_count "$path")"
  if [[ "$review_issues" -gt 0 ]]; then
    echo "pause"
    return 0
  fi
  echo "pass"
}

task_review_reason() {
  local project="$1"
  local path status
  path="$(tasks_path "$project")"
  status="$(task_review_status "$project")"
  case "$status" in
    pass) echo "tasks have clear outputs, acceptance, and proof commands" ;;
    approval-required) echo "task plan includes high-risk work requiring approval" ;;
    *)
      if [[ "$(task_status_count "$path" "blocked")" -gt 0 ]]; then
        echo "task plan has blocked item"
      elif [[ "$(task_review_issue_count "$path")" -gt 0 ]]; then
        echo "task plan has unclear acceptance or proof"
      else
        echo "task plan is missing executable tasks"
      fi
      ;;
  esac
}

ensure_task_plan_artifacts() {
  local project="$1"
  local phase="$2"
  local dir project_type
  dir="$(project_process_root "$project")"
  load_project_schema "$project"
  project_type="$PROJECT_TYPE"
  mkdir -p "$dir/tasks"
  write_project_template "$dir" "tasks/TASKS.md" "tasks.md" "$project" "$project_type"
  write_project_template "$dir" "tasks/EXECUTION_PLAN.md" "execution-plan.md" "$project" "$project_type"
  append_generated_task_if_needed "$project" "$phase"
}

write_execution_plan_snapshot() {
  local project="$1"
  local phase="$2"
  local path plan_path now status pending in_progress blocked source next_task
  path="$(tasks_path "$project")"
  plan_path="$(execution_plan_path "$project")"
  now="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  status="$(task_review_status "$project")"
  pending="$(task_status_count "$path" "pending,planned,todo")"
  in_progress="$(task_status_count "$path" "in_progress,in-progress,doing")"
  blocked="$(task_status_count "$path" "blocked")"
  source="$(task_plan_source_label "$path")"
  next_task="$(task_next_pending_summary "$path")"
  {
    echo
    echo "## Plan Snapshot $now"
    echo "- Phase: $phase"
    echo "- Source: $source"
    echo "- Plan Review: $status"
    echo "- Review reason: $(task_review_reason "$project")"
    echo "- Pending tasks: $pending"
    echo "- In progress tasks: $in_progress"
    echo "- Blocked tasks: $blocked"
    echo "- Safe Batch Policy: execute clear, low-risk tasks per heartbeat; batch together only when tasks share a module boundary or proof path."
    echo "- Next task: ${next_task:-none}"
  } >> "$plan_path"
}

task_plan_summary_for_phase() {
  local project="$1"
  local phase="$2"
  local path plan_path pending in_progress done blocked review source next_task
  load_project_applicability "$project"
  ensure_task_plan_artifacts "$project" "$phase"
  path="$(tasks_path "$project")"
  plan_path="$(execution_plan_path "$project")"
  pending="$(task_status_count "$path" "pending,planned,todo")"
  in_progress="$(task_status_count "$path" "in_progress,in-progress,doing")"
  done="$(task_status_count "$path" "done")"
  blocked="$(task_status_count "$path" "blocked")"
  review="$(task_review_status "$project")"
  source="$(task_plan_source_label "$path")"
  next_task="$(task_next_pending_summary "$path")"
  echo "Task plan:"
  echo "- Mode: $AUTONOMY_TASK_MODE"
  echo "- Board: $(project_process_display_root "$project")/tasks/TASKS.md"
  echo "- Execution plan: $(project_process_display_root "$project")/tasks/EXECUTION_PLAN.md"
  echo "- Source: $source"
  echo "- Pending tasks: $pending"
  echo "- In progress tasks: $in_progress"
  echo "- Done tasks: $done"
  echo "- Blocked tasks: $blocked"
  echo "- Plan Review: $review"
  echo "- Review reason: $(task_review_reason "$project")"
  echo "- Batch policy: $AUTONOMY_BATCH_POLICY"
  echo "- Batch grouping: prefer same module boundary or proof path"
  echo "- Heartbeat interval: $HEARTBEAT_INTERVAL"
  echo "- Next task: ${next_task:-none}"
}

task_plan_compact_for_phase() {
  local project="$1"
  local phase="$2"
  local path pending blocked review source next_task
  load_project_applicability "$project"
  ensure_task_plan_artifacts "$project" "$phase"
  path="$(tasks_path "$project")"
  pending="$(task_status_count "$path" "pending,planned,todo")"
  blocked="$(task_status_count "$path" "blocked")"
  review="$(task_review_status "$project")"
  source="$(task_plan_source_label "$path")"
  next_task="$(task_next_pending_summary "$path")"
  echo "Task plan:"
  echo "- Brief level: L0 navigator"
  echo "- Source: $source"
  echo "- Pending tasks: $pending"
  echo "- Blocked tasks: $blocked"
  echo "- Plan Review: $review"
  echo "- Review reason: $(task_review_reason "$project")"
  echo "- Batch policy: $AUTONOMY_BATCH_POLICY"
  echo "- Batch grouping: prefer same module boundary or proof path"
  echo "- Next task: ${next_task:-none}"
}

task_list_has_clear_multi_pending() {
  local project="$1"
  local path pending review
  path="$(tasks_path "$project")"
  pending="$(task_status_count "$path" "pending,planned,todo")"
  review="$(task_review_status "$project")"
  [[ "$pending" -ge 2 && "$review" == "pass" ]]
}

plan_task_queue_impl() {
  local project="$1"
  require_project "$project"
  ensure_control_for_uninitialized_project "$project"
  load_project_state "$project"
  load_project_schema "$project"
  ensure_status_artifacts "$(project_process_root "$project")" "$project" "$PROJECT_TYPE"
  ensure_task_plan_artifacts "$project" "$CURRENT_PHASE"
  write_execution_plan_snapshot "$project" "$CURRENT_PHASE"
  task_plan_summary_for_phase "$project" "$CURRENT_PHASE"
}

task_next_impl() {
  local project="$1"
  local path next_task
  require_project "$project"
  ensure_control_for_uninitialized_project "$project"
  load_project_state "$project"
  load_project_schema "$project"
  ensure_task_plan_artifacts "$project" "$CURRENT_PHASE"
  path="$(tasks_path "$project")"
  next_task="$(task_next_pending_summary "$path")"
  if [[ -z "$next_task" ]]; then
    echo "Next task: none"
    return 0
  fi
  echo "Next task: $next_task"
}

task_update_status_impl() {
  local project="$1"
  local task_id="$2"
  local status="$3"
  local note="${4:-}"
  local path tmp
  require_project "$project"
  ensure_control_for_uninitialized_project "$project"
  load_project_state "$project"
  load_project_schema "$project"
  ensure_task_plan_artifacts "$project" "$CURRENT_PHASE"
  path="$(tasks_path "$project")"
  tmp="$path.tmp"
  if ! awk -F'|' -v task_id="$task_id" -v new_status="$status" -v new_note="$note" '
    function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
    BEGIN { changed = 0 }
    /^\|/ {
      id = trim($2)
      if (id == task_id) {
        note = new_note == "" ? trim($10) : new_note
        print "| " id " | " trim($3) " | " trim($4) " | " trim($5) " | " trim($6) " | " trim($7) " | " trim($8) " | " new_status " | " note " |"
        changed = 1
        next
      }
    }
    { print }
    END { if (!changed) exit 3 }
  ' "$path" > "$tmp"; then
    rm -f "$tmp"
    echo "Unknown task id: ${task_id:-<missing>}" >&2
    return 1
  fi
  mv "$tmp" "$path"
  if [[ "$status" == "blocked" ]]; then
    write_project_state "$project" "$CURRENT_PHASE" "$CURRENT_TASK" "${note:-Task blocked: $task_id}" "$LAST_VERIFICATION"
  fi
  echo "Updated $task_id to $status"
}

load_autonomy_state() {
  local path
  path="$(autonomy_path "${1:-}")"
  AUTONOMY_CYCLE_COUNT="0"
  AUTONOMY_IDLE_CYCLES="0"
  AUTONOMY_LAST_PHASE="none"
  AUTONOMY_LAST_ACTION="none"
  AUTONOMY_LAST_RESULT="none"
  AUTONOMY_LAST_PROGRESS_AT="none"
  UI_POLISH_PASS_COUNT="0"
  UI_POLISH_LAST_PHASE="none"
  UI_POLISH_LAST_TASK="none"
  if [[ -f "$path" ]]; then
    # shellcheck disable=SC1090
    source "$path"
  fi
}

write_autonomy_state() {
  local project="$1"
  local path
  path="$(autonomy_path "$project")"
  mkdir -p "$(dirname "$path")"
  {
    printf 'AUTONOMY_CYCLE_COUNT=%q\n' "${AUTONOMY_CYCLE_COUNT:-0}"
    printf 'AUTONOMY_IDLE_CYCLES=%q\n' "${AUTONOMY_IDLE_CYCLES:-0}"
    printf 'AUTONOMY_LAST_PHASE=%q\n' "${AUTONOMY_LAST_PHASE:-none}"
    printf 'AUTONOMY_LAST_ACTION=%q\n' "${AUTONOMY_LAST_ACTION:-none}"
    printf 'AUTONOMY_LAST_RESULT=%q\n' "${AUTONOMY_LAST_RESULT:-none}"
    printf 'AUTONOMY_LAST_PROGRESS_AT=%q\n' "${AUTONOMY_LAST_PROGRESS_AT:-none}"
    printf 'UI_POLISH_PASS_COUNT=%q\n' "${UI_POLISH_PASS_COUNT:-0}"
    printf 'UI_POLISH_LAST_PHASE=%q\n' "${UI_POLISH_LAST_PHASE:-none}"
    printf 'UI_POLISH_LAST_TASK=%q\n' "${UI_POLISH_LAST_TASK:-none}"
  } > "$path"
}

phase_verified_loaded() {
  local phase="$1"
  case "${LAST_VERIFICATION:-}" in
    *"verify-phase:$phase passed"*|*"${phase}-check passed"*) return 0 ;;
    *) return 1 ;;
  esac
}

current_task_is_high_risk_loaded() {
  local lower_task
  lower_task="$(printf '%s' "${CURRENT_TASK:-}" | tr '[:upper:]' '[:lower:]')"
  case "$lower_task" in
    *payment*|*billing*|*security*|*permission*|*credential*|*secret*|*privacy*|*delete*|*destructive*|*production*|*launch*|*ship*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

current_task_is_polish_loaded() {
  local lower_task
  lower_task="$(printf '%s' "${CURRENT_TASK:-}" | tr '[:upper:]' '[:lower:]')"
  case "$lower_task" in
    *polish*|*visual*|*screenshot*|*simulator*|*fine-tune*|*打磨*|*视觉*|*截图*|*模拟机*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

ui_polish_budget_loaded() {
  case "${UI_POLISH_BUDGET:-1}" in
    ''|*[!0-9]*) echo 1 ;;
    *) echo "$UI_POLISH_BUDGET" ;;
  esac
}

ui_polish_count_loaded() {
  if [[ "${UI_POLISH_LAST_PHASE:-none}" == "${CURRENT_PHASE:-}" ]]; then
    case "${UI_POLISH_PASS_COUNT:-0}" in
      ''|*[!0-9]*) echo 0 ;;
      *) echo "$UI_POLISH_PASS_COUNT" ;;
    esac
    return 0
  fi
  echo 0
}

ui_polish_applies_loaded() {
  local project="$1"
  local phase="$2"
  [[ "$phase" == "build" ]] || return 1
  phase_is_applicable "$project" design
}

ui_polish_budget_exhausted_loaded() {
  local used budget
  used="$(ui_polish_count_loaded)"
  budget="$(ui_polish_budget_loaded)"
  [[ "$used" -ge "$budget" ]]
}

autonomy_stop_reason_loaded() {
  local project="$1"
  local phase="$2"
  local dir assets links next_phase review
  dir="$(project_process_root "$project")"
  if setting_disabled "$AUTONOMY_LOOP"; then
    echo "autonomy disabled"
    return 0
  fi
  if [[ -n "${BLOCKERS:-}" && "${BLOCKERS:-none}" != "none" ]]; then
    echo "blocker recorded"
    return 0
  fi
  if current_task_is_high_risk_loaded; then
    echo "approval required for high-risk action"
    return 0
  fi
  if ui_polish_applies_loaded "$project" "$phase" && ui_polish_budget_exhausted_loaded && current_task_is_polish_loaded; then
    echo "polish loop requires explicit user approval"
    return 0
  fi
  if [[ "${AUTONOMY_REVIEW_BEFORE_EXECUTE:-required}" != "disabled" ]]; then
    ensure_task_plan_artifacts "$project" "$phase"
    review="$(task_review_status "$project")"
    case "$review" in
      approval-required)
        echo "task plan requires approval"
        return 0
        ;;
      pause)
        echo "$(task_review_reason "$project")"
        return 0
        ;;
    esac
  fi
  case "$phase" in
    design)
      if references_required_loaded; then
        assets="$(count_reference_assets "$dir")"
        links="$(count_reference_links "$dir")"
        if [[ $((assets + links)) -eq 0 ]]; then
          echo "design references missing"
          return 0
        fi
      fi
      if setting_delegated "$UI_REFERENCES" && ! delegated_reference_board_present "$dir"; then
        echo "delegated reference board missing"
        return 0
      fi
      ;;
  esac
  next_phase="$(next_applicable_phase_after "$project" "$phase")"
  if [[ -z "$next_phase" ]] && phase_verified_loaded "$phase"; then
    echo "final applicable phase already verified"
    return 0
  fi
  return 1
}

autonomy_heartbeat_label_loaded() {
  local project="${1:-}"
  if [[ -n "$project" ]] && setting_enabled "${AUTONOMY_HEARTBEAT_ON_TASK_LIST:-enabled}" && task_list_has_clear_multi_pending "$project"; then
    echo "enabled"
    return 0
  fi
  if setting_enabled "$AUTONOMY_LOOP"; then
    echo "enabled"
    return 0
  fi
  case "${AUTONOMY_LOOP:-}" in
    suggest|suggested|auto)
      echo "suggested"
      ;;
    *)
      echo "no"
      ;;
  esac
}

autonomy_next_action_for_phase() {
  local project="${1:-}"
  local phase="${2:-}"
  local process_root
  if [[ -n "$project" ]]; then
    process_root="$(project_process_display_root "$project")"
  else
    process_root="dev-agent"
  fi
  if [[ -n "$project" ]] && task_list_has_clear_multi_pending "$project"; then
    echo "execute a safe batch of clear pending tasks, update TASKS.md statuses, run proof commands, then keep heartbeat only while review remains pass"
    return 0
  fi
  case "$phase" in
    idea)
      echo "refine $process_root/ideas/idea-brief.md, capture assumptions, then run verify-phase idea"
      ;;
    spec)
      echo "complete PRD and SPEC.md coverage, then run verify-phase spec"
      ;;
    design)
      echo "complete design handoff and visual system, then run design-check"
      ;;
    build)
      if ui_polish_applies_loaded "$project" "$phase" && ui_polish_budget_exhausted_loaded; then
        echo "advance to the next task; record P2/P3 UI debt in $process_root/reviews/UI_DEBT.md and only block on P0/P1"
      else
        echo "implement the next build slice, update verification evidence, then run verify-phase build and check"
      fi
      ;;
    qa)
      echo "run required QA evidence, then run verify-phase qa and qa-check when applicable"
      ;;
    ship)
      echo "prepare launch evidence and wait for production go/no-go approval"
      ;;
    *)
      echo "continue the current workflow phase"
      ;;
  esac
}

autonomy_decision_for_phase() {
  local project="$1"
  local phase="${2:-idea}"
  local reason continue heartbeat approval action
  load_project_state "$project"
  load_project_applicability "$project"
  load_autonomy_state "$project"
  reason=""
  if reason="$(autonomy_stop_reason_loaded "$project" "$phase")"; then
    continue="no"
    heartbeat="no"
  else
    continue="yes"
    heartbeat="$(autonomy_heartbeat_label_loaded "$project")"
    reason="current gate can continue without human input"
  fi
  approval="no"
  case "$reason" in
    approval*) approval="yes" ;;
  esac
  action="$(autonomy_next_action_for_phase "$project" "$phase")"
  echo "Autonomy:"
  echo "- Mode: $AUTONOMY_LOOP"
  echo "- Continue: $continue"
  echo "- Heartbeat: $heartbeat"
  echo "- Interval: $HEARTBEAT_INTERVAL"
  echo "- Max cycles: $AUTONOMY_MAX_CYCLES"
  echo "- Max idle cycles: $AUTONOMY_MAX_IDLE_CYCLES"
  echo "- Stop on: $AUTONOMY_STOP_ON"
  echo "- Cycle count: $AUTONOMY_CYCLE_COUNT"
  echo "- Plan Review: $(task_review_status "$project")"
  echo "- Batch policy: $AUTONOMY_BATCH_POLICY"
  if ui_polish_applies_loaded "$project" "$phase"; then
    echo "- UI polish budget: $(ui_polish_count_loaded)/$(ui_polish_budget_loaded) used"
    echo "- UI debt policy: $UI_DEBT_POLICY"
    if ui_polish_budget_exhausted_loaded; then
      echo "- Runtime visual pass: budget used; only P0/P1 blocks, record P2/P3 in reviews/UI_DEBT.md"
    else
      echo "- Runtime visual pass: optional; record only one pass before moving P2/P3 issues to UI debt"
    fi
  fi
  echo "- Next autonomous action: $action"
  echo "- Requires user approval: $approval"
  echo "- Reason: $reason"
}

autonomy_decision_compact_for_phase() {
  local project="$1"
  local phase="${2:-idea}"
  local reason continue heartbeat approval action
  load_project_state "$project"
  load_project_applicability "$project"
  load_autonomy_state "$project"
  reason=""
  if reason="$(autonomy_stop_reason_loaded "$project" "$phase")"; then
    continue="no"
    heartbeat="no"
  else
    continue="yes"
    heartbeat="$(autonomy_heartbeat_label_loaded "$project")"
    reason="current gate can continue without human input"
  fi
  approval="no"
  case "$reason" in
    approval*) approval="yes" ;;
  esac
  action="$(autonomy_next_action_for_phase "$project" "$phase")"
  echo "Autonomy:"
  echo "- Continue: $continue"
  echo "- Heartbeat: $heartbeat"
  echo "- Interval: $HEARTBEAT_INTERVAL"
  echo "- Plan Review: $(task_review_status "$project")"
  echo "- Batch policy: $AUTONOMY_BATCH_POLICY"
  if ui_polish_applies_loaded "$project" "$phase"; then
    echo "- UI polish budget: $(ui_polish_count_loaded)/$(ui_polish_budget_loaded) used"
  fi
  echo "- Next autonomous action: $action"
  echo "- Requires user approval: $approval"
  echo "- Reason: $reason"
}

record_ui_polish_pass_impl() {
  local project="$1"
  local dir used budget now
  require_project "$project"
  load_project_state "$project"
  load_project_schema "$project"
  load_project_applicability "$project"
  load_autonomy_state "$project"
  dir="$(project_process_root "$project")"
  if ! ui_polish_applies_loaded "$project" "$CURRENT_PHASE"; then
    echo "UI polish pass not applicable for $project at phase: $CURRENT_PHASE."
    echo "UI polish budget is only tracked for UI build work."
    return 0
  fi
  if [[ "${UI_POLISH_LAST_PHASE:-none}" != "$CURRENT_PHASE" ]]; then
    UI_POLISH_PASS_COUNT="0"
  fi
  used="$(ui_polish_count_loaded)"
  UI_POLISH_PASS_COUNT="$((used + 1))"
  UI_POLISH_LAST_PHASE="$CURRENT_PHASE"
  UI_POLISH_LAST_TASK="$CURRENT_TASK"
  AUTONOMY_LAST_PHASE="$CURRENT_PHASE"
  AUTONOMY_LAST_ACTION="ui-polish"
  AUTONOMY_LAST_RESULT="recorded"
  AUTONOMY_LAST_PROGRESS_AT="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  write_autonomy_state "$project"
  mkdir -p "$dir/reviews"
  write_project_template "$dir" "reviews/UI_DEBT.md" "ui-debt.md" "$project" "$PROJECT_TYPE"
  now="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  {
    echo
    echo "## Runtime Visual Pass $now"
    echo "- Phase: $CURRENT_PHASE"
    echo "- Task: $CURRENT_TASK"
    echo "- Count: $UI_POLISH_PASS_COUNT/$(ui_polish_budget_loaded)"
    echo "- Policy: $UI_DEBT_POLICY"
    echo "- P0/P1 issues block the current task."
    echo "- P2/P3 issues are non-blocking; record them in the debt table and advance."
  } >> "$dir/reviews/UI_DEBT.md"
  budget="$(ui_polish_budget_loaded)"
  echo "Recorded UI polish pass for $project."
  echo "Count: $UI_POLISH_PASS_COUNT/$budget"
  echo "Policy: $UI_DEBT_POLICY"
  if [[ "$UI_POLISH_PASS_COUNT" -ge "$budget" ]]; then
    echo "Budget used: record P2/P3 issues in reviews/UI_DEBT.md and advance unless P0/P1 remains."
  fi
}

delegation_recommendation_for_phase() {
  local project="$1"
  local phase="${2:-idea}"
  load_project_applicability "$project"
  echo "Parallelizable work:"
  if setting_disabled "$SUBAGENTS"; then
    echo "- Status: disabled"
    echo "- Reason: SUBAGENTS=$SUBAGENTS"
    return 0
  fi
  echo "- Status: available"
  echo "- Mode: $SUBAGENT_MODE"
  echo "- Max parallel subagents: $MAX_PARALLEL_SUBAGENTS"
  echo "- Host support required: yes"
  echo "- Task packet template: $(project_process_display_root "$project")/tasks/subagents/TEMPLATE.md"
  echo "- Suggested task packets:"
  case "$phase" in
    idea)
      echo "  - explorer: collect comparable products, constraints, and unanswered requirements without editing"
      echo "  - reviewer: challenge scope, assumptions, and acceptance criteria before spec"
      ;;
    spec)
      echo "  - explorer: inspect existing source, dependencies, and host constraints for SPEC.md inputs"
      echo "  - reviewer: check PRD/SPEC coverage and unresolved product risks"
      ;;
    design)
      echo "  - explorer: inspect references, prior design assets, and visual-system constraints"
      echo "  - reviewer: review DESIGN.md, VISUAL_SYSTEM.md, and SCREEN_ACCEPTANCE.md against the artifact contract"
      ;;
    build)
      echo "  - explorer: inspect nearby source, tests, and dependency patterns for the current slice"
      echo "  - worker: implement an isolated task packet with explicit write scope"
      echo "  - verifier: run gates and report command evidence after implementation"
      ;;
    qa)
      echo "  - verifier: run acceptance, monkey, or visual checks in parallel with fix preparation"
      echo "  - reviewer: inspect failures and isolate regressions without changing code"
      ;;
    ship)
      echo "  - verifier: gather release evidence, rollback checks, and residual risks"
      echo "  - reviewer: review go/no-go notes without making production changes"
      ;;
    *)
      echo "  - explorer: inspect context and return a bounded task packet recommendation"
      ;;
  esac
}

next_prompt_for_phase() {
  local project="$1"
  local phase="${2:-idea}"
  local next_phase
  if ! is_valid_phase "$phase"; then
    echo "Unknown phase: ${phase:-<missing>}"
    echo "Valid phases: idea, spec, design, build, qa, ship"
    return 0
  fi
  next_phase="$(next_applicable_phase_after "$project" "$phase")"
  echo "Brief level: L2 phase"
  echo "Execution navigator: follow this brief; do not bulk-read workflow Markdown."
  echo "Next command: Use local flow: $phase"
  echo "Command file: dev-agent/commands/$phase.md"
  echo "Primary skill files:"
  phase_skill_files "$project" "$phase"
  echo
  echo "Load:"
  phase_load_list "$project" "$phase"
  echo
  echo "Required outputs:"
  phase_required_outputs "$project" "$phase"
  echo
  echo "Gate before next phase:"
  phase_gate_list "$project" "$phase"
  echo
  echo "Blocked if:"
  phase_blockers "$project" "$phase"
  echo
  echo "After pass:"
  if [[ -n "$next_phase" ]]; then
    echo "- bin/dev-flow phase $project $next_phase \"$(phase_default_task "$next_phase")\""
  else
    echo "- Workflow is at the final applicable phase; keep verification evidence and blockers current."
  fi
  echo
  task_plan_compact_for_phase "$project" "$phase"
  echo
  autonomy_decision_compact_for_phase "$project" "$phase"
  echo
  echo "Subagents: run bin/dev-flow delegate $project when host subagents are available."
}

next_full_prompt_for_phase() {
  local project="$1"
  local phase="${2:-idea}"
  local next_phase
  if ! is_valid_phase "$phase"; then
    echo "Unknown phase: ${phase:-<missing>}"
    echo "Valid phases: idea, spec, design, build, qa, ship"
    return 0
  fi
  next_phase="$(next_applicable_phase_after "$project" "$phase")"
  echo "Brief level: L3 full"
  echo "Execution navigator: follow this brief; do not bulk-read workflow Markdown."
  echo "Next command: Use local flow: $phase"
  echo "Command file: dev-agent/commands/$phase.md"
  echo "Primary skill files:"
  phase_skill_files "$project" "$phase"
  echo
  echo "Load:"
  phase_load_list "$project" "$phase"
  echo
  echo "Required outputs:"
  phase_required_outputs "$project" "$phase"
  echo
  echo "Gate before next phase:"
  phase_gate_list "$project" "$phase"
  echo
  echo "Blocked if:"
  phase_blockers "$project" "$phase"
  echo
  echo "After pass:"
  if [[ -n "$next_phase" ]]; then
    echo "- bin/dev-flow phase $project $next_phase \"$(phase_default_task "$next_phase")\""
  else
    echo "- Workflow is at the final applicable phase; keep verification evidence and blockers current."
  fi
  echo
  task_plan_summary_for_phase "$project" "$phase"
  echo
  autonomy_decision_for_phase "$project" "$phase"
  echo
  delegation_recommendation_for_phase "$project" "$phase"
}

next_brief_for_phase() {
  local project="$1"
  local phase="${2:-idea}"
  local next_phase path next_task expected acceptance proof risk
  if ! is_valid_phase "$phase"; then
    echo "Unknown phase: ${phase:-<missing>}"
    echo "Valid phases: idea, spec, design, build, qa, ship"
    return 0
  fi
  next_phase="$(next_applicable_phase_after "$project" "$phase")"
  load_project_applicability "$project"
  ensure_task_plan_artifacts "$project" "$phase"
  path="$(tasks_path "$project")"
  next_task="$(task_next_pending_summary "$path")"
  expected="$(task_next_pending_column "$path" 5)"
  acceptance="$(task_next_pending_column "$path" 6)"
  proof="$(task_next_pending_column "$path" 7)"
  risk="$(task_next_pending_column "$path" 8)"
  echo "Brief level: L0 navigator"
  echo "Next command: Use local flow: $phase"
  echo "Command file: dev-agent/commands/$phase.md"
  echo "Next task: ${next_task:-none}"
  if [[ -n "$expected" ]]; then
    echo "Expected output: $expected"
  fi
  if [[ -n "$acceptance" ]]; then
    echo "Acceptance: $acceptance"
  fi
  if [[ -n "$proof" ]]; then
    echo "Proof command: $proof"
  fi
  if [[ -n "$risk" ]]; then
    echo "Risk: $risk"
  fi
  echo "Gate: $(task_primary_gate_for_phase "$project" "$phase")"
  if [[ -n "$next_phase" ]]; then
    echo "After pass: bin/dev-flow phase $project $next_phase \"$(phase_default_task "$next_phase")\""
  else
    echo "After pass: Workflow is at the final applicable phase; keep verification evidence and blockers current."
  fi
  echo "Stop if: $AUTONOMY_STOP_ON"
  echo "Expand: bin/dev-flow next $project --phase-brief | --full"
  echo
  task_plan_compact_for_phase "$project" "$phase"
  echo
  autonomy_decision_compact_for_phase "$project" "$phase"
}

mime_type_for_file() {
  local path="$1"
  file --mime-type -b "$path" 2>/dev/null || file -bI "$path" 2>/dev/null | sed 's/;.*//'
}

is_supported_artifact() {
  local path="$1"
  local kind="${2:-image}"
  local mime
  [[ -s "$path" ]] || return 1
  if command -v file >/dev/null 2>&1; then
    mime="$(mime_type_for_file "$path")"
    case "$kind:$mime" in
      image:image/svg+xml|image:text/xml|image:application/xml) return 1 ;;
      cut:image/svg+xml) return 0 ;;
      cut:text/xml|cut:application/xml)
        case "$path" in
          *.[Ss][Vv][Gg]) return 0 ;;
          *) return 1 ;;
        esac
        ;;
      image:image/*|image:application/pdf) return 0 ;;
      cut:image/*|cut:application/pdf) return 0 ;;
      reference:image/*|reference:application/pdf|reference:application/json) return 0 ;;
    esac
    case "$kind:$path" in
      reference:*.[Ff][Ii][Gg]) return 0 ;;
    esac
    return 1
  fi
  return 0
}

count_supported_artifacts() {
  local kind="$1"
  shift
  local existing=()
  local candidate
  for candidate in "$@"; do
    [[ -d "$candidate" ]] && existing+=("$candidate")
  done
  if [[ "${#existing[@]}" -eq 0 ]]; then
    echo 0
    return
  fi
  find "${existing[@]}" \
    -type f \( \
      -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o \
      -iname '*.gif' -o -iname '*.heic' -o -iname '*.pdf' -o -iname '*.fig' -o \
      -iname '*.svg' \
    \) -print0 2>/dev/null \
    | while IFS= read -r -d '' path; do
        if is_supported_artifact "$path" "$kind"; then
          printf '.\n'
        fi
      done \
    | wc -l \
    | tr -d ' '
}

count_unsupported_artifacts() {
  local kind="$1"
  shift
  local existing=()
  local candidate
  for candidate in "$@"; do
    [[ -d "$candidate" ]] && existing+=("$candidate")
  done
  if [[ "${#existing[@]}" -eq 0 ]]; then
    echo 0
    return
  fi
  find "${existing[@]}" \
    -type f \( \
      -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o \
      -iname '*.gif' -o -iname '*.heic' -o -iname '*.pdf' -o -iname '*.fig' -o \
      -iname '*.svg' \
    \) -print0 2>/dev/null \
    | while IFS= read -r -d '' path; do
        if ! is_supported_artifact "$path" "$kind"; then
          printf '.\n'
        fi
      done \
    | wc -l \
    | tr -d ' '
}

count_forbidden_svg_artifacts() {
  local existing=()
  local candidate
  for candidate in "$@"; do
    [[ -d "$candidate" ]] && existing+=("$candidate")
  done
  if [[ "${#existing[@]}" -eq 0 ]]; then
    echo 0
    return
  fi
  find "${existing[@]}" \
    -type f \( -iname '*.svg' -o -iname '*.xml' \) -print0 2>/dev/null \
    | while IFS= read -r -d '' _path; do
        printf '.\n'
      done \
    | wc -l \
    | tr -d ' '
}

count_reference_assets() {
  local dir="$1"
  count_supported_artifacts reference "$dir/design/references" "$dir/design/mocks" "$dir/design/screenshots"
}

count_reference_links() {
  local path="$1/design/reference-links.md"
  if [[ ! -f "$path" ]]; then
    echo 0
    return
  fi
  awk '
    /^## References/ { found = 1; next }
    found && $0 !~ /^[[:space:]]*$/ && $0 !~ /^#/ && $0 !~ /^<!--/ { count++ }
    END { print count + 0 }
  ' "$path"
}

count_visual_screenshots() {
  local dir="$1"
  count_supported_artifacts image "$dir/reviews/visual-screenshots"
}

count_acceptance_screenshots() {
  local dir="$1"
  count_supported_artifacts image "$dir/reviews/acceptance-screenshots"
}

count_design_mockups() {
  local dir="$1"
  count_supported_artifacts reference "$dir/design/mocks"
}

count_approved_design_artifacts() {
  local dir="$1"
  count_supported_artifacts image "$dir/design/approved"
}

count_approved_html_design_packages() {
  local dir="$1"
  local existing=()
  local candidate
  for candidate in "$dir/design/approved/html"; do
    [[ -d "$candidate" ]] && existing+=("$candidate")
  done
  if [[ "${#existing[@]}" -eq 0 ]]; then
    echo 0
    return
  fi
  find "${existing[@]}" -type f -iname '*.html' -print0 2>/dev/null \
    | while IFS= read -r -d '' path; do
        if is_formal_html_design_package "$dir" "$path"; then
          printf '.\n'
        fi
      done \
    | wc -l \
    | tr -d ' '
}

is_formal_visual_design_artifact() {
  local path="$1"
  local mime
  [[ -s "$path" ]] || return 1
  if command -v file >/dev/null 2>&1; then
    mime="$(mime_type_for_file "$path")"
    case "$mime" in
      image/svg+xml|text/xml|application/xml) return 1 ;;
      image/*|application/pdf) return 0 ;;
    esac
    return 1
  fi
  case "$path" in
    *.[Pp][Nn][Gg]|*.[Jj][Pp][Gg]|*.[Jj][Pp][Ee][Gg]|*.[Ww][Ee][Bb][Pp]|*.[Gg][Ii][Ff]|*.[Hh][Ee][Ii][Cc]|*.[Pp][Dd][Ff]) return 0 ;;
  esac
  return 1
}

is_formal_html_design_package() {
  local dir="$1"
  local path="$2"
  local lower
  [[ -s "$path" ]] || return 1
  lower="$(printf '%s' "$path" | tr '[:upper:]' '[:lower:]')"
  case "$lower" in
    *prototype*|*wireframe*|*sketch*|*draft*|*草图*|*原型*) return 1 ;;
  esac
  [[ "$path" == "$dir/design/approved/html/"*.html ]] || return 1
  grep -Eiq '<html|<main|<body' "$path" || return 1
  design_html_package_has_css "$dir" "$path"
}

is_formal_design_artifact() {
  local path="$1"
  is_formal_visual_design_artifact "$path"
}

count_final_design_artifacts() {
  local dir="$1"
  local existing=()
  local candidate
  for candidate in "$dir/design/approved"; do
    [[ -d "$candidate" ]] && existing+=("$candidate")
  done
  if [[ "${#existing[@]}" -eq 0 ]]; then
    echo 0
    return
  fi
  find "${existing[@]}" \
    -type f \( \
      -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.webp' -o \
      -iname '*.gif' -o -iname '*.heic' -o -iname '*.pdf' \
    \) -print0 2>/dev/null \
    | while IFS= read -r -d '' path; do
        if is_formal_design_artifact "$path"; then
          printf '.\n'
        fi
      done \
    | wc -l \
    | tr -d ' '
}

count_cut_assets() {
  local dir="$1"
  count_supported_artifacts cut "$dir/design/cut-assets"
}

cut_asset_manifest_entries() {
  local path="$1/design/cut-assets/ASSET_MANIFEST.md"
  if [[ ! -f "$path" ]]; then
    echo 0
    return
  fi
  awk '
    /^##[[:space:]]+Asset Manifest/ { in_manifest = 1; next }
    in_manifest && /^##[[:space:]]+/ { in_manifest = 0 }
    in_manifest && /^\|/ && $0 !~ /^\|[[:space:]]*-+/ && $0 !~ /Asset[[:space:]]*\|[[:space:]]*Source approved asset/ {
      if ($0 ~ /design\/cut-assets\// || $0 ~ /apps\/[^|]*\/assets\// || $0 ~ /packages\/[^|]*\/assets\//) count++
    }
    END { print count + 0 }
  ' "$path"
}

cut_assets_declared_not_required() {
  local path="$1/design/cut-assets/ASSET_MANIFEST.md"
  [[ -f "$path" ]] || return 1
  grep -Eiq '(CUT_ASSETS_REQUIRED:[[:space:]]*(no|false|none|not required)|No cut assets required)' "$path"
}

mobile_app_has_custom_icon_assets() {
  local dir="$1"
  local source_root app_json assets_dir
  source_root="$(source_root_for_process_dir "$dir")"
  app_json="$source_root/apps/mobile/app.json"
  assets_dir="$source_root/apps/mobile/assets"
  [[ -f "$app_json" ]] || return 0
  [[ -s "$assets_dir/icon.png" && -s "$assets_dir/adaptive-icon.png" && -s "$assets_dir/splash-icon.png" ]] || return 1
  if command -v shasum >/dev/null 2>&1; then
    # Expo's template placeholder icon on this machine uses this exact hash.
    local placeholder_hash current_hash
    placeholder_hash="a3fb1e435d60ecd713a55e1f19a19739da7c5f96"
    current_hash="$(shasum "$assets_dir/icon.png" | awk '{print $1}')"
    [[ "$current_hash" != "$placeholder_hash" ]] || return 1
  fi
  return 0
}

trim_md_cell() {
  printf '%s' "${1:-}" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//; s/^`//; s/`$//'
}

has_md_heading() {
  local path="$1"
  local heading="$2"
  [[ -f "$path" ]] || return 1
  grep -Eiq "^##[[:space:]]+${heading}([[:space:]]*$|[[:space:]]|:)" "$path"
}

has_md_heading_alias() {
  local path="$1"
  local aliases="$2"
  local alias
  local -a heading_aliases
  IFS='|' read -r -a heading_aliases <<< "$aliases"
  for alias in "${heading_aliases[@]}"; do
    if has_md_heading "$path" "$alias"; then
      return 0
    fi
  done
  return 1
}

check_required_headings() {
  local path="$1"
  local label="$2"
  shift 2
  local heading failures
  failures=0
  for heading in "$@"; do
    if ! has_md_heading "$path" "$heading"; then
      echo "Missing required section in $label: ## $heading" >&2
      failures=$((failures + 1))
    fi
  done
  [[ "$failures" -eq 0 ]]
}

check_required_heading_aliases() {
  local path="$1"
  local label="$2"
  shift 2
  local aliases display failures
  failures=0
  for aliases in "$@"; do
    display="${aliases%%|*}"
    if ! has_md_heading_alias "$path" "$aliases"; then
      echo "Missing required section in $label: ## $display" >&2
      failures=$((failures + 1))
    fi
  done
  [[ "$failures" -eq 0 ]]
}

check_design_package_structure() {
  local dir="$1"
  local failures
  failures=0
  check_required_heading_aliases "$dir/design/DESIGN.md" "design/DESIGN.md" \
    "UX Problem|UX 问题" "Recommended Direction|推荐方向" "Alternatives Considered|备选方案" \
    "Information Architecture|信息架构" "Interaction Model|交互模型" "Visual System|视觉系统" \
    "Design Artifacts|设计产物" "Build Implications|实施影响" || failures=$((failures + 1))
  check_required_heading_aliases "$dir/design/VISUAL_SYSTEM.md" "design/VISUAL_SYSTEM.md" \
    "Reference Influence|参考影响" "Palette|色彩" "Typography|字体|字体与文字|排版" \
    "Spacing and Layout|间距与布局" "Components and Motion|组件与动效|组件" \
    "Forbidden Patterns|禁止模式|禁用模式" || failures=$((failures + 1))
  check_screen_acceptance_structure "$dir" || failures=$((failures + 1))
  [[ "$failures" -eq 0 ]]
}

required_design_screens() {
  local dir="$1"
  local path="$dir/design/SCREEN_ACCEPTANCE.md"
  [[ -f "$path" ]] || return 0
  awk '
    /^##[[:space:]]+/ {
      sub(/^##[[:space:]]+/, "")
      gsub(/[[:space:]]+$/, "")
      if ($0 != "") print
    }
  ' "$path"
}

design_artifact_ledger_path() {
  local dir="$1"
  printf '%s/design/DESIGN_ARTIFACTS.md' "$dir"
}

design_image_description_ledger_path() {
  local dir="$1"
  printf '%s/design/DESIGN_IMAGE_DESCRIPTIONS.md' "$dir"
}

design_artifacts_has_header() {
  local dir="$1"
  local path
  path="$(design_artifact_ledger_path "$dir")"
  [[ -f "$path" ]] || return 1
  grep -Eiq '^\|[[:space:]]*Screen[[:space:]]*\|[[:space:]]*State[[:space:]]*\|[[:space:]]*Source type[[:space:]]*\|[[:space:]]*Source reference[[:space:]]*\|[[:space:]]*Approved asset path[[:space:]]*\|[[:space:]]*Resolution / export[[:space:]]*\|[[:space:]]*Status[[:space:]]*\|[[:space:]]*Implementation notes[[:space:]]*\|[[:space:]]*$' "$path"
}

is_forbidden_design_source() {
  local raw="$1"
  local lower
  lower="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"
  case "$lower" in
    *screenshot*|*screencap*|*screencapture*|*snapshot*|*capture*|*playwright*|*puppeteer*|*chrome*|*localhost*|*browser*|*simulator*|*runtime*|*render*|*rasteriz*|*html-to-image*|*html2canvas*|*canvas*|*svg*|*design/drafts*|*design/mocks*|*design/screenshots*|*reviews/acceptance-screenshots*|*reviews/visual-screenshots*|*apps/*|*prototype*|*wireframe*|*sketch*|*draft*|*草图*|*原型*|*截图*|*截屏*|*渲染*)
      return 1
      ;;
  esac
  return 0
}

is_allowed_design_source_type() {
  local raw="$1"
  local lower
  lower="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"
  case "$lower" in
    imagegen|gpt-image-2|gpt-image|figma|figma-mcp)
      return 0
      ;;
    *screenshot*|*screencap*|*capture*|*playwright*|*puppeteer*|*chrome*|*browser*|*simulator*|*runtime*|*render*|*rasteriz*|*html*|*canvas*|*svg*|*draft*|*prototype*|*wireframe*|*sketch*|*manual*|*local*|*草图*|*原型*|*截图*|*渲染*)
      return 1
      ;;
  esac
  return 1
}

is_html_design_source_type() {
  local raw="$1"
  local lower
  lower="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"
  [[ "$lower" == "html-design" ]]
}

is_valid_formal_design_source_ref() {
  local source_type="$1"
  local source_ref="$2"
  local lower_type lower_ref
  source_ref="$(trim_md_cell "$source_ref")"
  lower_type="$(printf '%s' "$source_type" | tr '[:upper:]' '[:lower:]')"
  lower_ref="$(printf '%s' "$source_ref" | tr '[:upper:]' '[:lower:]')"
  [[ -n "$source_ref" && "$source_ref" != "-" && "$source_ref" != "TBD" && "$source_ref" != "TODO" ]] || return 1
  is_forbidden_design_source "$source_ref" || return 1
  case "$lower_type" in
    imagegen) [[ "$lower_ref" == imagegen://* ]] ;;
    gpt-image) [[ "$lower_ref" == gpt-image://* ]] ;;
    gpt-image-2) [[ "$lower_ref" == gpt-image-2://* ]] ;;
    figma|figma-mcp) is_valid_figma_source_ref "$source_ref" ;;
    *) return 1 ;;
  esac
}

is_project_approved_design_path() {
  local dir="$1"
  local saved_path="$2"
  local full_path="$3"
  case "$saved_path" in
    design/approved/*|./design/approved/*)
      [[ "$full_path" == "$dir/"* ]]
      ;;
    /*)
      [[ "$full_path" == "$dir/design/approved/"* ]]
      ;;
    *)
      return 1
      ;;
  esac
}

is_figma_design_source_type() {
  local raw="$1"
  local lower
  lower="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"
  case "$lower" in
    figma|figma-mcp) return 0 ;;
    *) return 1 ;;
  esac
}

is_ai_generated_design_source_type() {
  local raw="$1"
  local lower
  lower="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"
  case "$lower" in
    imagegen|gpt-image|gpt-image-2) return 0 ;;
    *) return 1 ;;
  esac
}

is_identity_asset_row() {
  local raw="$*"
  local lower
  lower="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"
  case "$lower" in
    *logo*|*app\ icon*|*app-icon*|*adaptive\ icon*|*adaptive-icon*|*splash\ icon*|*splash-icon*|*launcher\ icon*|*brand\ mark*|*brand\ kv*|*brand/key\ visual*|*key\ visual*|*应用图标*|*启动图标*|*品牌标识*|*品牌kv*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

is_icon_asset_row() {
  local raw="$*"
  local lower
  lower="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"
  case "$lower" in
    *icon*|*app\ icon*|*app-icon*|*adaptive\ icon*|*adaptive-icon*|*splash\ icon*|*splash-icon*|*launcher\ icon*|*launcher-icon*|*logo*|*brand\ mark*|*brand-mark*|*图标*|*应用图标*|*启动图标*|*标识*)
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

html_companion_required_for_design_row() {
  local source_type="$1"
  shift || true
  if is_figma_design_source_type "$source_type"; then
    return 1
  fi
  if is_icon_asset_row "$@"; then
    return 1
  fi
  return 0
}

html_description_path_from_notes() {
  local raw="$1"
  printf '%s\n' "$raw" \
    | grep -Eo '(\./)?design/approved/html/[^[:space:]|,;)]*\.html' \
    | head -n 1 \
    | sed 's#^\./##'
}

css_design_package_paths_from_notes() {
  local raw="$1"
  printf '%s\n' "$raw" \
    | grep -Eo '(\./)?design/approved/html/[^[:space:]|,;)]*\.css' \
    | sed 's#^\./##'
}

optional_design_resource_paths_from_notes() {
  local raw="$1"
  printf '%s\n' "$raw" \
    | grep -Eo '(\./)?design/(approved/html|cut-assets)/[^[:space:]|,;)]*\.(js|json)' \
    | sed 's#^\./##'
}

is_project_html_description_path() {
  local dir="$1"
  local saved_path="$2"
  local full_path="$3"
  case "$saved_path" in
    design/approved/html/*.html|./design/approved/html/*.html)
      [[ "$full_path" == "$dir/"* && -s "$full_path" ]]
      ;;
    /*)
      [[ "$full_path" == "$dir/design/approved/html/"*.html && -s "$full_path" ]]
      ;;
    *)
      return 1
      ;;
  esac
}

is_project_approved_html_design_path() {
  local dir="$1"
  local saved_path="$2"
  local full_path="$3"
  is_project_html_description_path "$dir" "$saved_path" "$full_path" || return 1
  is_formal_html_design_package "$dir" "$full_path"
}

resolve_design_relative_path() {
  local dir="$1"
  local base_file="$2"
  local raw="$3"
  local base_dir
  raw="${raw%%\?*}"
  raw="${raw%%#*}"
  [[ -n "$raw" ]] || return 1
  case "$raw" in
    http://*|https://*|data:*|mailto:*|tel:*|javascript:*) return 1 ;;
    /*) printf '%s\n' "$raw" ;;
    design/*|./design/*) printf '%s/%s\n' "$dir" "${raw#./}" ;;
    *)
      base_dir="$(dirname "$base_file")"
      printf '%s/%s\n' "$base_dir" "$raw"
      ;;
  esac
}

design_html_package_has_css() {
  local dir="$1"
  local html_file="$2"
  local css_ref css_path found
  [[ -s "$html_file" ]] || return 1
  found=0
  while IFS= read -r css_ref; do
    [[ -n "$css_ref" ]] || continue
    css_path="$(resolve_design_relative_path "$dir" "$html_file" "$css_ref" || true)"
    [[ -n "$css_path" && -s "$css_path" ]] && found=1
  done < <(grep -Eio 'href=["'\''][^"'\'']+\.css([^"'\'']*)?["'\'']' "$html_file" 2>/dev/null | sed -E 's/^href=["'\'']([^"'\'']+)["'\'']$/\1/')
  [[ "$found" -eq 1 ]] && return 0
  grep -Eiq '<style[[:space:]>]' "$html_file"
}

validate_design_package_resources() {
  local dir="$1"
  local screen="$2"
  local html_path="$3"
  local html_full_path="$4"
  local notes="$5"
  local failures=0
  local css_path css_full_path resource_path resource_full_path
  if ! is_project_approved_html_design_path "$dir" "$html_path" "$html_full_path"; then
    echo "Invalid HTML/CSS design package for screen: $screen (HTML must be a non-empty design package under design/approved/html/ with CSS, not a draft/prototype)." >&2
    failures=$((failures + 1))
  fi
  while IFS= read -r css_path; do
    [[ -n "$css_path" ]] || continue
    case "$css_path" in
      /*) css_full_path="$css_path" ;;
      *) css_full_path="$dir/$css_path" ;;
    esac
    if [[ "$css_full_path" != "$dir/design/approved/html/"*.css || ! -s "$css_full_path" ]]; then
      echo "Invalid CSS design package resource for screen: $screen (CSS must be a real file under design/approved/html/)." >&2
      failures=$((failures + 1))
    fi
  done < <(css_design_package_paths_from_notes "$notes" || true)
  while IFS= read -r resource_path; do
    [[ -n "$resource_path" ]] || continue
    case "$resource_path" in
      /*) resource_full_path="$resource_path" ;;
      *) resource_full_path="$dir/$resource_path" ;;
    esac
    if [[ "$resource_full_path" != "$dir/design/approved/html/"*.js && "$resource_full_path" != "$dir/design/approved/html/"*.json && "$resource_full_path" != "$dir/design/cut-assets/"*.json ]] || [[ ! -s "$resource_full_path" ]]; then
      echo "Invalid motion design resource for screen: $screen (JS/Lottie resources must be real files under design/approved/html/ or design/cut-assets/)." >&2
      failures=$((failures + 1))
    fi
  done < <(optional_design_resource_paths_from_notes "$notes" || true)
  [[ "$failures" -eq 0 ]]
}

image_html_description_mentions() {
  local dir="$1"
  local asset_path="$2"
  local html_path="$3"
  local path
  path="$(design_image_description_ledger_path "$dir")"
  [[ -f "$path" ]] || return 1
  grep -Fq "$asset_path" "$path" && grep -Fq "$html_path" "$path"
}

is_missing_trace_value() {
  local raw lower
  raw="$(trim_md_cell "${1:-}")"
  lower="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"
  case "$lower" in
    ""|"-"|"tbd"|"todo") return 0 ;;
    *) return 1 ;;
  esac
}

is_not_applicable_trace_value() {
  local raw lower
  raw="$(trim_md_cell "${1:-}")"
  lower="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"
  case "$lower" in
    ""|"-"|"n/a"|"na"|"none"|"not required"|"not-required"|"no formal asset"|"no formal assets")
      return 0
      ;;
    *)
      return 1
      ;;
  esac
}

design_artifact_row_field_for_screen_asset() {
  local dir="$1"
  local screen="$2"
  local asset="$3"
  local field="$4"
  local path line in_coverage
  local screen_cell source_type_cell source_ref_cell asset_cell notes_cell
  local screen_name source_type source_ref asset_path notes html_path
  path="$(design_artifact_ledger_path "$dir")"
  [[ -f "$path" ]] || return 1
  in_coverage=false
  while IFS= read -r line; do
    if [[ "$line" =~ ^##[[:space:]]+Screen[[:space:]]+Coverage ]]; then
      in_coverage=true
      continue
    fi
    if [[ "$in_coverage" == true && "$line" =~ ^##[[:space:]]+ ]]; then
      break
    fi
    [[ "$in_coverage" == true && "$line" == \|* ]] || continue
    [[ "$line" == *"|---"* || "$line" == *"---|"* ]] && continue
    [[ "$line" =~ ^\|[[:space:]]*Screen[[:space:]]*\| ]] && continue
    IFS='|' read -r _ screen_cell _ source_type_cell source_ref_cell asset_cell _ _ notes_cell _ <<< "$line"
    screen_name="$(trim_md_cell "$screen_cell")"
    source_type="$(trim_md_cell "$source_type_cell")"
    source_ref="$(trim_md_cell "$source_ref_cell")"
    asset_path="$(trim_md_cell "$asset_cell")"
    notes="$(trim_md_cell "$notes_cell")"
    [[ "$screen_name" == "$screen" && "$asset_path" == "$asset" ]] || continue
    case "$field" in
      source_type) printf '%s\n' "$source_type" ;;
      source_ref) printf '%s\n' "$source_ref" ;;
      html)
        html_path="$(html_description_path_from_notes "$notes" || true)"
        if [[ -z "$html_path" ]]; then
          case "$asset_path" in
            design/approved/html/*.html|./design/approved/html/*.html)
              html_path="${asset_path#./}"
              ;;
          esac
        fi
        printf '%s\n' "$html_path"
        ;;
      *) return 1 ;;
    esac
    return 0
  done < "$path"
  return 1
}

is_valid_figma_source_ref() {
  local raw="$1"
  local lower
  raw="$(trim_md_cell "$raw")"
  lower="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"
  [[ -n "$raw" && "$raw" != "-" && "$raw" != "TBD" && "$raw" != "TODO" ]] || return 1
  case "$lower" in
    figma://*|https://figma.com/*|https://www.figma.com/*) return 0 ;;
    *) return 1 ;;
  esac
}

count_figma_design_artifact_rows() {
  local dir="$1"
  local path line source_type_cell source_type rows in_coverage
  path="$(design_artifact_ledger_path "$dir")"
  [[ -f "$path" ]] || { echo 0; return; }
  rows=0
  in_coverage=false
  while IFS= read -r line; do
    if [[ "$line" =~ ^##[[:space:]]+Screen[[:space:]]+Coverage ]]; then
      in_coverage=true
      continue
    fi
    if [[ "$in_coverage" == true && "$line" =~ ^##[[:space:]]+ ]]; then
      break
    fi
    [[ "$in_coverage" == true && "$line" == \|* ]] || continue
    [[ "$line" == *"|---"* || "$line" == *"---|"* ]] && continue
    [[ "$line" =~ ^\|[[:space:]]*Screen[[:space:]]*\| ]] && continue
    IFS='|' read -r _ _ _ source_type_cell _ _ _ _ _ <<< "$line"
    source_type="$(trim_md_cell "$source_type_cell")"
    if is_figma_design_source_type "$source_type"; then
      rows=$((rows + 1))
    fi
  done < "$path"
  echo "$rows"
}

count_design_artifact_rows() {
  local dir="$1"
  local path line rows in_coverage
  path="$(design_artifact_ledger_path "$dir")"
  [[ -f "$path" ]] || { echo 0; return; }
  rows=0
  in_coverage=false
  while IFS= read -r line; do
    if [[ "$line" =~ ^##[[:space:]]+Screen[[:space:]]+Coverage ]]; then
      in_coverage=true
      continue
    fi
    if [[ "$in_coverage" == true && "$line" =~ ^##[[:space:]]+ ]]; then
      break
    fi
    [[ "$in_coverage" == true && "$line" == \|* ]] || continue
    [[ "$line" == *"|---"* || "$line" == *"---|"* ]] && continue
    [[ "$line" =~ ^\|[[:space:]]*Screen[[:space:]]*\| ]] && continue
    rows=$((rows + 1))
  done < "$path"
  echo "$rows"
}

figma_handoff_path() {
  local dir="$1"
  printf '%s/design/FIGMA_HANDOFF.md' "$dir"
}

figma_handoff_mentions() {
  local dir="$1"
  local source_ref="$2"
  local asset_path="$3"
  local path
  path="$(figma_handoff_path "$dir")"
  [[ -f "$path" ]] || return 1
  grep -Fq "$source_ref" "$path" && grep -Fq "$asset_path" "$path"
}

check_design_artifact_contract() {
  local dir="$1"
  local path
  local line in_coverage rows failures
  local screen_cell state_cell source_type_cell source_ref_cell asset_cell resolution_cell status_cell notes_cell
  local screen source_type source_ref asset_path asset_full_path resolution status notes html_path html_full_path
  local html_required
  path="$(design_artifact_ledger_path "$dir")"
  [[ -f "$path" ]] || return 1
  failures=0
  rows=0
  in_coverage=false
  if ! design_artifacts_has_header "$dir"; then
    echo "Missing formal design artifact columns in design/DESIGN_ARTIFACTS.md: Screen Coverage must use '| Screen | State | Source type | Source reference | Approved asset path | Resolution / export | Status | Implementation notes |'." >&2
    failures=$((failures + 1))
  fi
  while IFS= read -r line; do
    if [[ "$line" =~ ^##[[:space:]]+Screen[[:space:]]+Coverage ]]; then
      in_coverage=true
      continue
    fi
    if [[ "$in_coverage" == true && "$line" =~ ^##[[:space:]]+ ]]; then
      break
    fi
    [[ "$in_coverage" == true && "$line" == \|* ]] || continue
    [[ "$line" == *"|---"* || "$line" == *"---|"* ]] && continue
    [[ "$line" =~ ^\|[[:space:]]*Screen[[:space:]]*\| ]] && continue
    IFS='|' read -r _ screen_cell state_cell source_type_cell source_ref_cell asset_cell resolution_cell status_cell notes_cell _ <<< "$line"
    screen="$(trim_md_cell "$screen_cell")"
    source_type="$(trim_md_cell "$source_type_cell")"
    source_ref="$(trim_md_cell "$source_ref_cell")"
    asset_path="$(trim_md_cell "$asset_cell")"
    resolution="$(trim_md_cell "$resolution_cell")"
    status="$(trim_md_cell "$status_cell")"
    notes="$(trim_md_cell "$notes_cell")"
    [[ -n "$screen" ]] || continue
    rows=$((rows + 1))
    if is_html_design_source_type "$source_type"; then
      echo "HTML/CSS companion cannot be the formal design source for screen: $screen (use imagegen, gpt-image, gpt-image-2, figma, or figma-mcp; put the HTML/CSS package in Implementation notes as a companion when required)." >&2
      failures=$((failures + 1))
    elif ! is_allowed_design_source_type "$source_type"; then
      echo "Invalid formal design source for screen: $screen (Source type must be imagegen, gpt-image, gpt-image-2, figma, or figma-mcp. Manual/local/rendered/uploaded/external/design-system/screenshot/HTML-only sources are forbidden for build-ready UI handoff)." >&2
      failures=$((failures + 1))
    fi
    if ! is_html_design_source_type "$source_type" && ! is_valid_formal_design_source_ref "$source_type" "$source_ref"; then
      echo "Invalid design source reference for screen: $screen (record an Image Gen/GPT Image reference such as imagegen:// or gpt-image-2://, or a Figma reference such as figma:// or a Figma URL. Do not use SVG renders, HTML packages, screenshots, browser captures, simulator captures, local app output, uploads, design-system exports, external exports, or prototype paths as development-ready design sources)." >&2
      failures=$((failures + 1))
    fi
    if is_identity_asset_row "$screen" "$source_ref" "$asset_path" "$resolution" "$notes" && ! is_ai_generated_design_source_type "$source_type"; then
      echo "Identity assets require Image Gen provenance for screen: $screen (use Source type imagegen, gpt-image, or gpt-image-2; do not create SVG/HTML/canvas locally and render PNG for logo, app icon, brand mark, or brand KV assets)." >&2
      failures=$((failures + 1))
    fi
    if [[ ! "$status" =~ [Aa]pproved|[Ff]inal|正式|批准|通过 ]]; then
      echo "Missing approved status for screen: $screen (Status must mark the asset as approved/final before implementation)." >&2
      failures=$((failures + 1))
    fi
    if [[ -z "$resolution" || "$resolution" == "-" || "$resolution" == "TBD" || "$resolution" == "TODO" ]]; then
      echo "Missing resolution/export note for screen: $screen (record viewport, Figma frame, export scale, or image dimensions)." >&2
      failures=$((failures + 1))
    fi
    case "$asset_path" in
      /*) asset_full_path="$asset_path" ;;
      *) asset_full_path="$dir/$asset_path" ;;
    esac
    if ! is_forbidden_design_source "$asset_path" || ! is_project_approved_design_path "$dir" "$asset_path" "$asset_full_path" || ! is_formal_visual_design_artifact "$asset_full_path"; then
      echo "Invalid approved design asset for screen: $screen (Approved asset path must be a real raster/PDF visual design asset under design/approved/. HTML/CSS packages belong in Implementation notes as companions, not as the formal approved asset)." >&2
      failures=$((failures + 1))
    fi
    html_required="false"
    if html_companion_required_for_design_row "$source_type" "$screen" "$source_ref" "$asset_path" "$resolution" "$notes"; then
      html_required="true"
    fi
    html_path="$(html_description_path_from_notes "$notes" || true)"
    html_full_path=""
    if [[ -n "$html_path" ]]; then
      case "$html_path" in
        /*) html_full_path="$html_path" ;;
        *) html_full_path="$dir/$html_path" ;;
      esac
      if ! validate_design_package_resources "$dir" "$screen" "$html_path" "$html_full_path" "$notes"; then
        failures=$((failures + 1))
      fi
    elif [[ "$html_required" == "true" ]]; then
      echo "Missing HTML/CSS design package for screen: $screen (non-Figma, non-icon design assets must include a synchronized path such as 'HTML: design/approved/html/${screen}.html' and its CSS resources; do not invent HTML detached from the Image Gen/GPT Image output)." >&2
      failures=$((failures + 1))
    fi
    if is_ai_generated_design_source_type "$source_type" && [[ "$html_required" == "true" ]]; then
      if [[ -z "$html_path" ]]; then
        echo "Missing AI design HTML description for screen: $screen (non-icon Image Gen/GPT Image rows must include a synchronized HTML companion path such as 'HTML: design/approved/html/${screen}.html')." >&2
        failures=$((failures + 1))
      else
        if ! is_project_html_description_path "$dir" "$html_path" "$html_full_path"; then
          echo "Invalid AI design HTML description for screen: $screen (HTML companion must be a real non-empty .html file under design/approved/html/)." >&2
          failures=$((failures + 1))
        fi
        if ! image_html_description_mentions "$dir" "$asset_path" "$html_path"; then
          echo "Missing AI design HTML description ledger row for screen: $screen (design/DESIGN_IMAGE_DESCRIPTIONS.md must map the approved image to the HTML companion)." >&2
          failures=$((failures + 1))
        fi
      fi
    fi
  done < "$path"
  if [[ "$rows" -eq 0 ]]; then
    echo "Missing formal design artifact rows: add at least one Screen Coverage row in design/DESIGN_ARTIFACTS.md." >&2
    failures=$((failures + 1))
  fi
  [[ "$failures" -eq 0 ]]
}

screen_has_approved_design_asset() {
  local dir="$1"
  local screen="$2"
  local ledger
  local line screen_cell path_cell screen_name saved_path full_path
  ledger="$(design_artifact_ledger_path "$dir")"
  [[ -f "$ledger" ]] || return 1
  while IFS= read -r line; do
    [[ "$line" == \|* ]] || continue
    [[ "$line" == *"|---"* || "$line" == *"---|"* ]] && continue
    [[ "$line" =~ ^\|[[:space:]]*Screen[[:space:]]*\| ]] && continue
    IFS='|' read -r _ screen_cell _ _ _ path_cell _ _ _ <<< "$line"
    screen_name="$(trim_md_cell "$screen_cell")"
    [[ "$screen_name" == "$screen" ]] || continue
    saved_path="$(trim_md_cell "$path_cell")"
    [[ -n "$saved_path" ]] || continue
    case "$saved_path" in
      /*) full_path="$saved_path" ;;
      *) full_path="$dir/$saved_path" ;;
    esac
    if is_project_approved_design_path "$dir" "$saved_path" "$full_path" && is_formal_visual_design_artifact "$full_path"; then
      return 0
    fi
  done < "$ledger"
  return 1
}

check_screen_acceptance_structure() {
  local dir="$1"
  local path="$dir/design/SCREEN_ACCEPTANCE.md"
  [[ -f "$path" ]] || return 1
  awk '
    function flush() {
      if (screen == "") return
      if (!source || !content || !states || !breakpoints || !visual || !accessibility) {
        print "Incomplete screen acceptance section: " screen " (requires Requirement source, Required content, Required states, Breakpoints, Visual acceptance, and Accessibility acceptance)." > "/dev/stderr"
        failures++
      }
    }
    /^##[[:space:]]+/ {
      flush()
      screen = $0
      sub(/^##[[:space:]]+/, "", screen)
      gsub(/[[:space:]]+$/, "", screen)
      source = content = states = breakpoints = visual = accessibility = 0
      seen = 1
      next
    }
    screen != "" {
      if ($0 ~ /(Requirement source|Source requirements|需求来源)[：:][[:space:]]*[^[:space:]-]/ && $0 !~ /(TBD|TODO|待定)/) source = 1
      if ($0 ~ /(Required content|必备内容)[：:][[:space:]]*[^[:space:]-]/ && $0 !~ /(TBD|TODO|待定)/) content = 1
      if ($0 ~ /(Required states|必备状态)[：:]/) states = 1
      if ($0 ~ /(Breakpoints|断点)[：:]/) breakpoints = 1
      if ($0 ~ /(Visual acceptance|视觉验收)[：:]/) visual = 1
      if ($0 ~ /(Accessibility acceptance|无障碍验收)[：:]/) accessibility = 1
    }
    END {
      flush()
      if (!seen) {
        print "Missing screen acceptance headings: add one or more ## Screen Name sections to design/SCREEN_ACCEPTANCE.md." > "/dev/stderr"
        failures++
      }
      exit failures
    }
  ' "$path"
}

check_design_screen_coverage() {
  local dir="$1"
  local missing=0
  local required=0
  local screen
  while IFS= read -r screen; do
    required=$((required + 1))
    if ! screen_has_approved_design_asset "$dir" "$screen"; then
      echo "Missing approved design asset for screen: $screen (add a raster/PDF path for this screen in design/DESIGN_ARTIFACTS.md)." >&2
      missing=$((missing + 1))
    fi
  done < <(required_design_screens "$dir")
  if [[ "$required" -eq 0 ]]; then
    echo "Missing screen acceptance headings: add one or more '## Screen Name' sections to design/SCREEN_ACCEPTANCE.md." >&2
    return 1
  fi
  [[ "$missing" -eq 0 ]]
}

check_visual_comparison_screen_coverage() {
  local dir="$1"
  local path="$dir/reviews/VISUAL_COMPARISON.md"
  local missing screen required
  missing=0
  required=0
  [[ -f "$path" ]] || return 1
  while IFS= read -r screen; do
    required=$((required + 1))
    if ! grep -Fq "$screen" "$path"; then
      echo "Missing visual comparison coverage for screen: $screen" >&2
      missing=$((missing + 1))
    fi
  done < <(required_design_screens "$dir")
  [[ "$required" -gt 0 && "$missing" -eq 0 ]]
}

plan_references_design_contract() {
  local dir="$1"
  local path="$dir/tasks/PLAN.md"
  [[ -f "$path" ]] || return 1
  grep -Eiq 'DESIGN\.md|VISUAL_SYSTEM\.md|SCREEN_ACCEPTANCE\.md|DESIGN_ARTIFACTS\.md|approved design|design/approved|VISUAL_COMPARISON' "$path"
}

delegated_reference_board_present() {
  local dir="$1"
  has_content "$dir/design/REFERENCE_BOARD.md"
}

check_implementation_trace_coverage() {
  local dir="$1"
  local require_assets="${2:-true}"
  local path="$dir/tasks/IMPLEMENTATION_TRACE.md"
  local missing required line screen
  local screen_cell state_cell target_cell asset_cell design_source_cell html_cell cut_cell test_cell status_cell
  local target_path asset_path design_source html_companion cut_assets test_evidence status
  local asset_full_path html_full_path expected_source_type expected_source_ref expected_html
  local expected_html_required
  missing=0
  required=0
  [[ -f "$path" ]] || return 1
  if ! grep -Eiq '^\|[[:space:]]*Screen[[:space:]]*\|[[:space:]]*State[[:space:]]*\|[[:space:]]*Implementation target[[:space:]]*\|[[:space:]]*Approved asset[[:space:]]*\|[[:space:]]*Design source[[:space:]]*\|[[:space:]]*HTML companion[[:space:]]*\|[[:space:]]*Cut assets[[:space:]]*\|[[:space:]]*Test evidence[[:space:]]*\|[[:space:]]*Status[[:space:]]*\|[[:space:]]*$' "$path"; then
    echo "Missing implementation trace columns in tasks/IMPLEMENTATION_TRACE.md: use '| Screen | State | Implementation target | Approved asset | Design source | HTML companion | Cut assets | Test evidence | Status |'." >&2
    return 1
  fi
  while IFS= read -r screen; do
    required=$((required + 1))
    local found=0
    while IFS= read -r line; do
      [[ "$line" == \|* ]] || continue
      [[ "$line" == *"|---"* || "$line" == *"---|"* ]] && continue
      [[ "$line" =~ ^\|[[:space:]]*Screen[[:space:]]*\| ]] && continue
      IFS='|' read -r _ screen_cell state_cell target_cell asset_cell design_source_cell html_cell cut_cell test_cell status_cell _ <<< "$line"
      [[ "$(trim_md_cell "$screen_cell")" == "$screen" ]] || continue
      target_path="$(trim_md_cell "$target_cell")"
      asset_path="$(trim_md_cell "$asset_cell")"
      design_source="$(trim_md_cell "$design_source_cell")"
      html_companion="$(trim_md_cell "$html_cell")"
      cut_assets="$(trim_md_cell "$cut_cell")"
      test_evidence="$(trim_md_cell "$test_cell")"
      status="$(trim_md_cell "$status_cell")"
      if is_missing_trace_value "$target_path" || is_missing_trace_value "$test_evidence" || is_missing_trace_value "$status"; then
        echo "Incomplete implementation trace row for screen: $screen" >&2
        missing=$((missing + 1))
      fi
      if [[ "$require_assets" != "true" ]]; then
        if is_not_applicable_trace_value "$asset_path"; then
          found=1
          break
        fi
      fi
      if is_missing_trace_value "$asset_path" || is_missing_trace_value "$design_source" || is_missing_trace_value "$cut_assets"; then
        echo "Incomplete implementation trace design mapping for screen: $screen" >&2
        missing=$((missing + 1))
      fi
      case "$asset_path" in
        /*) asset_full_path="$asset_path" ;;
        *) asset_full_path="$dir/$asset_path" ;;
      esac
      if ! is_project_approved_design_path "$dir" "$asset_path" "$asset_full_path" || ! is_formal_design_artifact "$asset_full_path" "$dir"; then
        echo "Invalid implementation trace approved asset for screen: $screen (Approved asset must be a real raster/PDF visual design asset under design/approved/; HTML/CSS belongs in the HTML companion column)." >&2
        missing=$((missing + 1))
      fi
      expected_source_type="$(design_artifact_row_field_for_screen_asset "$dir" "$screen" "$asset_path" source_type || true)"
      expected_source_ref="$(design_artifact_row_field_for_screen_asset "$dir" "$screen" "$asset_path" source_ref || true)"
      expected_html="$(design_artifact_row_field_for_screen_asset "$dir" "$screen" "$asset_path" html || true)"
      if [[ -z "$expected_source_type" || -z "$expected_source_ref" ]]; then
        echo "Missing design artifact mapping for implementation trace screen: $screen (Approved asset must match design/DESIGN_ARTIFACTS.md Screen Coverage)." >&2
        missing=$((missing + 1))
      elif [[ "$design_source" != *"$expected_source_ref"* ]]; then
        echo "Implementation trace design source mismatch for screen: $screen (Design source must reference $expected_source_ref)." >&2
        missing=$((missing + 1))
      fi
      if is_figma_design_source_type "$expected_source_type" && ! is_valid_figma_source_ref "$design_source"; then
        echo "Missing implementation trace Figma source for screen: $screen (Design source must be a figma://... reference or Figma URL)." >&2
        missing=$((missing + 1))
      fi
      expected_html_required="false"
      if html_companion_required_for_design_row "$expected_source_type" "$screen" "$expected_source_ref" "$asset_path"; then
        expected_html_required="true"
      fi
      if [[ "$expected_html_required" == "true" && ( -z "$expected_html" || "$html_companion" != *"$expected_html"* ) ]]; then
        echo "Missing implementation trace HTML companion for screen: $screen (HTML companion must reference ${expected_html:-the synchronized HTML path from design/DESIGN_ARTIFACTS.md})." >&2
        missing=$((missing + 1))
      elif [[ -n "$expected_html" && "$html_companion" == *"$expected_html"* ]]; then
        case "$expected_html" in
          /*) html_full_path="$expected_html" ;;
          *) html_full_path="$dir/$expected_html" ;;
        esac
        if ! is_project_html_description_path "$dir" "$expected_html" "$html_full_path"; then
          echo "Invalid implementation trace HTML companion for screen: $screen (HTML companion must be a real non-empty .html file under design/approved/html/)." >&2
          missing=$((missing + 1))
        fi
      fi
      found=1
      break
    done < "$path"
    if [[ "$found" -eq 0 ]]; then
      echo "Missing implementation trace coverage for screen: $screen" >&2
      missing=$((missing + 1))
    fi
  done < <(required_design_screens "$dir")
  [[ "$required" -gt 0 && "$missing" -eq 0 ]]
}

check_visual_comparison_contract() {
  local dir="$1"
  local path="$dir/reviews/VISUAL_COMPARISON.md"
  local missing required line screen
  local screen_cell asset_cell source_raster_cell runtime_cell calibration_cell diff_cell score_cell decision_cell notes_cell full_path
  missing=0
  required=0
  [[ -f "$path" ]] || return 1
  if ! grep -Eiq '^\|[[:space:]]*Screen[[:space:]]*\|[[:space:]]*Approved asset path[[:space:]]*\|[[:space:]]*Source raster baseline[[:space:]]*\|[[:space:]]*Runtime surface[[:space:]]*\|[[:space:]]*Calibration[[:space:]]*\|[[:space:]]*Diff artifact[[:space:]]*\|[[:space:]]*Fidelity score[[:space:]]*\|[[:space:]]*Decision[[:space:]]*\|[[:space:]]*Notes[[:space:]]*\|[[:space:]]*$' "$path"; then
    echo "Missing visual comparison matrix columns in reviews/VISUAL_COMPARISON.md: use '| Screen | Approved asset path | Source raster baseline | Runtime surface | Calibration | Diff artifact | Fidelity score | Decision | Notes |'." >&2
    return 1
  fi
  while IFS= read -r screen; do
    required=$((required + 1))
    local found=0
    while IFS= read -r line; do
      [[ "$line" == \|* ]] || continue
      [[ "$line" == *"|---"* || "$line" == *"---|"* ]] && continue
      [[ "$line" =~ ^\|[[:space:]]*Screen[[:space:]]*\| ]] && continue
      IFS='|' read -r _ screen_cell asset_cell source_raster_cell runtime_cell calibration_cell diff_cell score_cell decision_cell notes_cell _ <<< "$line"
      [[ "$(trim_md_cell "$screen_cell")" == "$screen" ]] || continue
      asset_cell="$(trim_md_cell "$asset_cell")"
      source_raster_cell="$(trim_md_cell "$source_raster_cell")"
      runtime_cell="$(trim_md_cell "$runtime_cell")"
      calibration_cell="$(trim_md_cell "$calibration_cell")"
      diff_cell="$(trim_md_cell "$diff_cell")"
      score_cell="$(trim_md_cell "$score_cell")"
      decision_cell="$(trim_md_cell "$decision_cell")"
      case "$asset_cell" in
        /*) full_path="$asset_cell" ;;
        *) full_path="$dir/$asset_cell" ;;
      esac
      if [[ -z "$source_raster_cell" || "$source_raster_cell" == "-" || "$source_raster_cell" == "TBD" || "$source_raster_cell" == "TODO" ||
            -z "$runtime_cell" || "$runtime_cell" == "-" || "$runtime_cell" == "TBD" || "$runtime_cell" == "TODO" ||
            -z "$calibration_cell" || "$calibration_cell" == "-" || "$calibration_cell" == "TBD" || "$calibration_cell" == "TODO" ||
            -z "$diff_cell" || "$diff_cell" == "-" || "$diff_cell" == "TBD" || "$diff_cell" == "TODO" ||
            -z "$decision_cell" || "$decision_cell" == "-" || "$decision_cell" == "TBD" || "$decision_cell" == "TODO" ||
            ! "$score_cell" =~ ^[0-9]+(/[0-9]+)?$ ]] || ! is_project_approved_design_path "$dir" "$asset_cell" "$full_path" || ! is_formal_design_artifact "$full_path" "$dir"; then
        echo "Incomplete visual comparison row for screen: $screen" >&2
        missing=$((missing + 1))
      fi
      found=1
      break
    done < "$path"
    if [[ "$found" -eq 0 ]]; then
      echo "Missing visual comparison coverage for screen: $screen" >&2
      missing=$((missing + 1))
    fi
  done < <(required_design_screens "$dir")
  [[ "$required" -gt 0 && "$missing" -eq 0 ]]
}

asset_check_impl() {
  local project="$1"
  local dir failures design_assets html_packages final_design_assets cut_assets cut_manifest_entries forbidden_design_svgs
  require_project "$project"
  dir="$(project_process_root "$project")"
  failures=0
  if ! design_assets_required "$project"; then
    load_project_applicability "$project"
    echo "Asset check skipped for $project: UI_DESIGN_ASSETS=$UI_DESIGN_ASSETS, VISUAL_QA=$VISUAL_QA, UI_FIGMA_HANDOFF=$UI_FIGMA_HANDOFF."
    return 0
  fi
  check_design_asset_applicability_contract "$project" || failures=$((failures + 1))
  design_assets="$(count_approved_design_artifacts "$dir")"
  html_packages="$(count_approved_html_design_packages "$dir")"
  final_design_assets="$(count_final_design_artifacts "$dir")"
  forbidden_design_svgs="$(count_forbidden_svg_artifacts "$dir/design/approved")"
  if ! has_content "$dir/design/DESIGN_ARTIFACTS.md"; then
    echo "Missing or too thin: design/DESIGN_ARTIFACTS.md" >&2
    failures=$((failures + 1))
  fi
  if [[ -f "$dir/design/DESIGN_ARTIFACTS.md" ]] && ! check_design_artifact_contract "$dir"; then
    failures=$((failures + 1))
  fi
  if [[ "$forbidden_design_svgs" -gt 0 ]]; then
    echo "Forbidden SVG/XML file under design/approved/: keep SVG, Mermaid, and code-native sketches under design/drafts/ or design/mocks/; approved design boards must be raster/PDF exports." >&2
    failures=$((failures + 1))
  fi
  if [[ "$(count_invalid_approved_design_artifacts "$dir")" -gt 0 ]]; then
    echo "Invalid approved design artifact(s): files under design/approved/ must be real non-empty image/PDF files, not text placeholders." >&2
    failures=$((failures + 1))
  fi
  if [[ "$design_assets" -eq 0 ]]; then
    echo "Missing approved visual design assets: save 1-N Image Gen/GPT Image or Figma raster/PDF assets under design/approved/ before high-fidelity UI build. Required HTML/CSS packages are synchronized companions, not standalone formal sources." >&2
    failures=$((failures + 1))
  fi
  if [[ "$final_design_assets" -eq 0 ]]; then
    echo "Missing final approved visual design asset: SVG/Mermaid/code-native/HTML drafts are structure drafts only, not implementation targets; design/approved/ must include at least one formal raster/PDF visual asset." >&2
    failures=$((failures + 1))
  fi
  if ! check_design_screen_coverage "$dir"; then
    failures=$((failures + 1))
  fi
  cut_assets="$(count_cut_assets "$dir")"
  cut_manifest_entries="$(cut_asset_manifest_entries "$dir")"
  if [[ "$cut_assets" -gt 0 || "$cut_manifest_entries" -gt 0 ]]; then
    if [[ "$cut_assets" -eq 0 || "$cut_manifest_entries" -eq 0 ]]; then
      echo "Incomplete cut-asset manifest: files under design/cut-assets/ and rows in ASSET_MANIFEST.md must both exist when cut assets are required." >&2
      failures=$((failures + 1))
    fi
  elif ! cut_assets_declared_not_required "$dir"; then
    echo "Missing cut-asset decision: list required SVG/bitmap element assets in design/cut-assets/ASSET_MANIFEST.md or record 'CUT_ASSETS_REQUIRED: no' with rationale." >&2
    failures=$((failures + 1))
  fi
  if [[ "$failures" -gt 0 ]]; then
    echo "Asset check failed for $project." >&2
    return 1
  fi
  echo "Asset check passed for $project with $design_assets approved visual asset(s) and $html_packages approved HTML/CSS design package(s)."
}

figma_check_impl() {
  local project="$1"
  local dir path line in_coverage rows failures
  local screen_cell source_type_cell source_ref_cell asset_cell resolution_cell status_cell
  local screen source_type source_ref asset_path resolution status asset_full_path
  require_project "$project"
  dir="$(project_process_root "$project")"
  path="$(design_artifact_ledger_path "$dir")"
  failures=0
  rows=0
  in_coverage=false
  load_project_applicability "$project"
  if setting_disabled "$UI_FIGMA_HANDOFF"; then
    echo "Figma handoff check skipped for $project: UI_FIGMA_HANDOFF=$UI_FIGMA_HANDOFF."
    return 0
  fi
  if [[ ! -f "$path" ]]; then
    if setting_enabled "$UI_FIGMA_HANDOFF"; then
      echo "Missing design artifact ledger: design/DESIGN_ARTIFACTS.md" >&2
      return 1
    fi
    echo "Figma handoff check skipped for $project: no DESIGN_ARTIFACTS.md ledger."
    return 0
  fi
  while IFS= read -r line; do
    if [[ "$line" =~ ^##[[:space:]]+Screen[[:space:]]+Coverage ]]; then
      in_coverage=true
      continue
    fi
    if [[ "$in_coverage" == true && "$line" =~ ^##[[:space:]]+ ]]; then
      break
    fi
    [[ "$in_coverage" == true && "$line" == \|* ]] || continue
    [[ "$line" == *"|---"* || "$line" == *"---|"* ]] && continue
    [[ "$line" =~ ^\|[[:space:]]*Screen[[:space:]]*\| ]] && continue
    IFS='|' read -r _ screen_cell _ source_type_cell source_ref_cell asset_cell resolution_cell status_cell _ _ <<< "$line"
    screen="$(trim_md_cell "$screen_cell")"
    source_type="$(trim_md_cell "$source_type_cell")"
    source_ref="$(trim_md_cell "$source_ref_cell")"
    asset_path="$(trim_md_cell "$asset_cell")"
    resolution="$(trim_md_cell "$resolution_cell")"
    status="$(trim_md_cell "$status_cell")"
    [[ -n "$screen" ]] || continue
    is_figma_design_source_type "$source_type" || continue
    rows=$((rows + 1))
    if ! is_valid_figma_source_ref "$source_ref"; then
      echo "Missing Figma source reference for screen: $screen (use figma://... or a Figma URL with file/node context)." >&2
      failures=$((failures + 1))
    fi
    if [[ -z "$resolution" || "$resolution" == "-" || "$resolution" == "TBD" || "$resolution" == "TODO" ]]; then
      echo "Missing Figma export detail for screen: $screen (record frame size, node, export scale, and format)." >&2
      failures=$((failures + 1))
    fi
    if [[ ! "$status" =~ [Aa]pproved|[Ff]inal|正式|批准|通过 ]]; then
      echo "Missing approved Figma handoff status for screen: $screen." >&2
      failures=$((failures + 1))
    fi
    case "$asset_path" in
      /*) asset_full_path="$asset_path" ;;
      *) asset_full_path="$dir/$asset_path" ;;
    esac
    if ! is_project_approved_design_path "$dir" "$asset_path" "$asset_full_path" || ! is_formal_visual_design_artifact "$asset_full_path"; then
      echo "Invalid Figma approved export for screen: $screen (export must be a real raster/PDF under design/approved/)." >&2
      failures=$((failures + 1))
    fi
    if is_valid_figma_source_ref "$source_ref" && is_project_approved_design_path "$dir" "$asset_path" "$asset_full_path" && ! figma_handoff_mentions "$dir" "$source_ref" "$asset_path"; then
      echo "Missing Figma handoff ledger row for screen: $screen (design/FIGMA_HANDOFF.md must mention the Figma source and approved export)." >&2
      failures=$((failures + 1))
    fi
  done < "$path"
  if [[ "$rows" -eq 0 ]]; then
    if setting_enabled "$UI_FIGMA_HANDOFF"; then
      echo "Missing Figma handoff rows: add figma or figma-mcp Screen Coverage rows in design/DESIGN_ARTIFACTS.md." >&2
      failures=$((failures + 1))
    else
      echo "Figma handoff check skipped for $project: no Figma-backed design artifact rows."
      return 0
    fi
  fi
  if [[ "$rows" -gt 0 ]]; then
    if ! has_content "$(figma_handoff_path "$dir")"; then
      echo "Missing or too thin: design/FIGMA_HANDOFF.md" >&2
      failures=$((failures + 1))
    fi
  fi
  if [[ "$failures" -gt 0 ]]; then
    echo "Figma handoff check failed for $project." >&2
    return 1
  fi
  echo "Figma handoff check passed for $project with $rows Figma-backed design artifact row(s)."
}

count_invalid_approved_design_artifacts() {
  local dir="$1"
  count_unsupported_artifacts image "$dir/design/approved"
}

count_cut_assets() {
  local dir="$1"
  count_supported_artifacts cut "$dir/design/cut-assets"
}

has_content() {
  local path="$1"
  [[ -s "$path" ]] && [[ "$(wc -l < "$path" | tr -d ' ')" -ge 5 ]]
}

load_project_applicability() {
  local path
  load_project_schema "${1:-}"
  AGENT_CONTRACT="auto"
  AUTOMATED_QA="auto"
  VISUAL_QA="auto"
  SHIP_FLOW="auto"
  AUTONOMY_LOOP="suggest"
  AUTONOMY_TASK_MODE="task-list"
  AUTONOMY_REVIEW_BEFORE_EXECUTE="required"
  AUTONOMY_HEARTBEAT_ON_TASK_LIST="enabled"
  AUTONOMY_BATCH_POLICY="safe-batch"
  HEARTBEAT_INTERVAL="1m"
  AUTONOMY_MAX_CYCLES="10"
  AUTONOMY_MAX_IDLE_CYCLES="2"
  AUTONOMY_STOP_ON="complete,blocked,approval-required,plan-review-failed,no-progress,gate-failed"
  SUBAGENTS="auto"
  MAX_PARALLEL_SUBAGENTS="3"
  SUBAGENT_MODE="sidecar"
  UI_POLISH_BUDGET="1"
  UI_DEBT_POLICY="record-and-advance"
  case "$PROJECT_TYPE" in
    agent)
      AGENT_CONTRACT="required"
      UI_FLOW="disabled"
      UI_REFERENCES="disabled"
      UI_DESIGN_ASSETS="disabled"
      UI_FIGMA_HANDOFF="disabled"
      UI_MOCKUPS="disabled"
      VISUAL_QA="disabled"
      SHIP_FLOW="auto"
      ;;
    api|library|docs)
      UI_FLOW="disabled"
      UI_REFERENCES="disabled"
      UI_DESIGN_ASSETS="disabled"
      UI_FIGMA_HANDOFF="disabled"
      UI_MOCKUPS="disabled"
      VISUAL_QA="disabled"
      SHIP_FLOW="auto"
      ;;
    *)
      UI_FLOW="required"
      UI_REFERENCES="required"
      UI_DESIGN_ASSETS="auto"
      UI_FIGMA_HANDOFF="auto"
      UI_MOCKUPS="auto"
      VISUAL_QA="auto"
      SHIP_FLOW="auto"
      ;;
  esac
  GIT_CHECKPOINTS="auto"
  path="$(applicability_path "${1:-}")"
  if [[ -f "$path" ]]; then
    # shellcheck disable=SC1090
    source "$path"
  fi
  if [[ -z "${AGENT_CONTRACT:-}" && -n "${AGENT_FLOW:-}" ]]; then
    AGENT_CONTRACT="$AGENT_FLOW"
  fi
}

setting_enabled() {
  case "${1:-}" in
    required|enabled|true|yes|1) return 0 ;;
    *) return 1 ;;
  esac
}

setting_disabled() {
  case "${1:-}" in
    disabled|false|no|0|skip|off) return 0 ;;
    *) return 1 ;;
  esac
}

setting_delegated() {
  case "${1:-}" in
    delegated|delegate|user-delegated|visual-direction-delegated) return 0 ;;
    *) return 1 ;;
  esac
}

references_required_loaded() {
  setting_disabled "$UI_REFERENCES" && return 1
  setting_delegated "$UI_REFERENCES" && return 1
  return 0
}

references_required() {
  load_project_applicability "$1"
  references_required_loaded
}

qa_required() {
  load_project_applicability "$1"
  setting_enabled "$AUTOMATED_QA" && return 0
  setting_enabled "$VISUAL_QA" && return 0
  return 1
}

visual_qa_required() {
  load_project_applicability "$1"
  setting_enabled "$VISUAL_QA" && return 0
  return 1
}

design_assets_required() {
  local project="$1"
  local dir
  load_project_applicability "$project"
  if design_flow_active_for_assets "$project"; then
    return 0
  fi
  setting_disabled "$UI_DESIGN_ASSETS" && return 1
  setting_enabled "$UI_DESIGN_ASSETS" && return 0
  setting_enabled "$VISUAL_QA" && return 0
  setting_enabled "$UI_FIGMA_HANDOFF" && return 0
  dir="$(project_process_root "$project")"
  [[ "$(count_approved_design_artifacts "$dir")" -gt 0 ]] && return 0
  [[ "$(count_approved_html_design_packages "$dir")" -gt 0 ]] && return 0
  [[ "$(count_design_artifact_rows "$dir")" -gt 0 ]] && return 0
  [[ "$(count_figma_design_artifact_rows "$dir")" -gt 0 ]] && return 0
  return 1
}

design_flow_active_for_assets() {
  local project="$1"
  load_project_applicability "$project"
  setting_disabled "$UI_FLOW" && return 1
  setting_enabled "$UI_FLOW" && return 0
  [[ "$PROJECT_TYPE" == "ui" ]] && return 0
  has_phase_artifact "$project" design
}

design_assets_disabled_conflict() {
  local project="$1"
  load_project_applicability "$project"
  design_flow_active_for_assets "$project" || return 1
  setting_disabled "$UI_DESIGN_ASSETS"
}

check_design_asset_applicability_contract() {
  local project="$1"
  if design_assets_disabled_conflict "$project"; then
    echo "Invalid design applicability: UI_DESIGN_ASSETS cannot be disabled while UI_FLOW is active. If the task is truly no-UI/no-UX/code-only, set UI_FLOW=\"disabled\" and document that in SPEC.md; otherwise produce formal visual design assets through Image Gen/GPT Image or Figma." >&2
    return 1
  fi
}

ship_required() {
  local project="$1"
  local dir
  load_project_applicability "$project"
  setting_disabled "$SHIP_FLOW" && return 1
  setting_enabled "$SHIP_FLOW" && return 0
  dir="$(project_process_root "$project")"
  has_content "$dir/ship/LAUNCH.md"
}

agent_contract_applies() {
  local project="$1"
  load_project_applicability "$project"
  setting_disabled "$AGENT_CONTRACT" && return 1
  setting_enabled "$AGENT_CONTRACT" && return 0
  has_phase_artifact "$project" agent
}

has_phase_artifact() {
  local project="$1"
  local phase="$2"
  local dir
  dir="$(project_process_root "$project")"
  case "$phase" in
    agent)
      [[ -s "$dir/agent/AGENT_SPEC.md" || -s "$dir/agent/WORKFLOW.md" || -s "$dir/agent/TOOLS_AND_PERMISSIONS.md" || -s "$dir/agent/PROMPTS_AND_SKILLS.md" || -s "$dir/agent/EVALS.md" || -s "$dir/agent/FAILURE_RECOVERY.md" || -s "$dir/agent/OPERATIONS.md" ]]
      ;;
    design)
      [[ -s "$dir/design/DESIGN.md" || -s "$dir/design/VISUAL_SYSTEM.md" || -s "$dir/design/SCREEN_ACCEPTANCE.md" ]] && return 0
      [[ "$(count_reference_assets "$dir")" -gt 0 || "$(count_reference_links "$dir")" -gt 0 || "$(count_design_mockups "$dir")" -gt 0 || "$(count_approved_design_artifacts "$dir")" -gt 0 || "$(count_approved_html_design_packages "$dir")" -gt 0 ]]
      ;;
    *)
      return 1
      ;;
  esac
}

phase_is_applicable() {
  local project="$1"
  local phase="$2"
  load_project_applicability "$project"
  case "$phase" in
    idea|spec|build)
      return 0
      ;;
    design)
      setting_disabled "$UI_FLOW" && return 1
      setting_enabled "$UI_FLOW" && return 0
      has_phase_artifact "$project" design
      ;;
    qa)
      qa_required "$project"
      ;;
    ship)
      ship_required "$project"
      ;;
    *)
      return 1
      ;;
  esac
}

phase_index() {
  case "${1:-}" in
    idea) echo 0 ;;
    spec) echo 1 ;;
    design) echo 2 ;;
    build) echo 3 ;;
    qa) echo 4 ;;
    ship) echo 5 ;;
    *) echo -1 ;;
  esac
}

verify_prior_applicable_phases() {
  local project="$1"
  local phase="$2"
  local target_idx candidate candidate_idx failures
  target_idx="$(phase_index "$phase")"
  failures=0
  for candidate in idea spec design build qa ship; do
    candidate_idx="$(phase_index "$candidate")"
    if [[ "$candidate_idx" -ge 0 && "$candidate_idx" -lt "$target_idx" ]]; then
      if phase_is_applicable "$project" "$candidate"; then
        echo "Verifying prior phase before entering $phase: $candidate"
        if ! verify_phase_impl "$project" "$candidate"; then
          failures=$((failures + 1))
        fi
      fi
    fi
  done
  [[ "$failures" -eq 0 ]]
}

record_verification() {
  local project="$1"
  local text="$2"
  load_project_state "$project"
  write_project_state "$project" "$CURRENT_PHASE" "$CURRENT_TASK" "$BLOCKERS" "$text"
}

set_project_applicability() {
  local project="$1"
  local key="$2"
  local value="$3"
  local path tmp
  path="$(applicability_path "$project")"
  mkdir -p "$(dirname "$path")"
  tmp="$path.tmp"
  if [[ -f "$path" && "$(grep -c "^$key=" "$path" || true)" -gt 0 ]]; then
    awk -v key="$key" -v value="$value" '
      $0 ~ "^" key "=" { print key "=\"" value "\""; next }
      { print }
    ' "$path" > "$tmp"
    mv "$tmp" "$path"
  else
    printf '%s="%s"\n' "$key" "$value" >> "$path"
  fi
}

require_content_file() {
  local dir="$1"
  local rel="$2"
  if ! has_content "$dir/$rel"; then
    echo "Missing or too thin: $rel" >&2
    return 1
  fi
}

require_file_pattern() {
  local dir="$1"
  local rel="$2"
  local label="$3"
  local pattern="$4"
  [[ -f "$dir/$rel" ]] || return 0
  if ! grep -Eiq "$pattern" "$dir/$rel"; then
    echo "Missing $label in $rel." >&2
    return 1
  fi
}

check_ui_spec_product_coverage() {
  local dir="$1"
  local failures=0
  require_file_pattern "$dir" "product/PRD.md" "PRD coverage: MVP scope" 'MVP|Scope|范围|功能范围|必做功能' || failures=$((failures + 1))
  require_file_pattern "$dir" "product/PRD.md" "PRD coverage: core flows or information architecture" '核心流程|关键流程|用户流程|信息架构|Core Flows?|User Flows?|Information Architecture' || failures=$((failures + 1))
  require_file_pattern "$dir" "product/PRD.md" "PRD coverage: acceptance criteria" '验收|Acceptance Criteria|Acceptance' || failures=$((failures + 1))
  require_file_pattern "$dir" "product/PRD.md" "PRD coverage: non-goals or out-of-scope items" '非目标|暂不做|不做|Non-Goals?|Out of Scope|Not Doing' || failures=$((failures + 1))

  require_file_pattern "$dir" "specs/SPEC.md" "SPEC coverage: stack/platform constraints" 'Tech Stack|Platform And Stack|技术栈|平台|架构|Stack' || failures=$((failures + 1))
  require_file_pattern "$dir" "specs/SPEC.md" "SPEC coverage: commands" '(^## +Commands)|命令|xcodebuild|npm run|cargo test|swift test|make ' || failures=$((failures + 1))
  require_file_pattern "$dir" "specs/SPEC.md" "SPEC coverage: data/domain model" 'Data Model|Domain Model|数据模型|领域模型|Schema|Entity' || failures=$((failures + 1))
  require_file_pattern "$dir" "specs/SPEC.md" "SPEC coverage: testing strategy" 'Testing Strategy|Test Strategy|测试|Tests?' || failures=$((failures + 1))
  require_file_pattern "$dir" "specs/SPEC.md" "SPEC coverage: UI/design applicability" 'UI / Design Applicability|Design Applicability|UI_FLOW|UI_DESIGN_ASSETS|设计适用|设计流程' || failures=$((failures + 1))
  require_file_pattern "$dir" "specs/SPEC.md" "SPEC coverage: privacy/security" 'Privacy|Security|权限|隐私|安全|Keychain|permission' || failures=$((failures + 1))
  require_file_pattern "$dir" "specs/SPEC.md" "SPEC coverage: open questions" 'Open Questions|待确认|未决|Questions' || failures=$((failures + 1))

  [[ "$failures" -eq 0 ]]
}

technical_plan_has_build_slice_row() {
  local path="$1"
  awk '
    /^## +Build Slice Plan/ { in_section = 1; next }
    in_section && /^## +/ { exit }
    in_section && /^\|/ && $0 !~ /\|[[:space:]]*-+[[:space:]]*\|/ && $0 !~ /\|[[:space:]]*Slice[[:space:]]*\|/ {
      filled = 0
      fields = split($0, cols, "|")
      for (i = 2; i < fields; i++) {
        cell = cols[i]
        gsub(/^[[:space:]]+|[[:space:]]+$/, "", cell)
        if (cell != "") {
          filled++
        }
      }
      if (filled >= 7) {
        found = 1
      }
    }
    END { exit(found ? 0 : 1) }
  ' "$path"
}

technical_plan_has_placeholder() {
  local path="$1"
  grep -Eiq 'Target runtime\(s\):[[:space:]]*$|Cross-platform decision:[[:space:]]*$|Development language\(s\):[[:space:]]*$|Key tradeoffs:[[:space:]]*$|Applicability:[[:space:]]*$|Architecture pattern, including MVVM when relevant:[[:space:]]*$|Component/module boundaries:[[:space:]]*$|State management:[[:space:]]*$|Routing/navigation:[[:space:]]*$|Framework and rendering model:[[:space:]]*$|Component structure and shared primitives:[[:space:]]*$|State management and data fetching:[[:space:]]*$|Routing:[[:space:]]*$|Build/package boundaries:[[:space:]]*$|Service/module boundary:[[:space:]]*$|API/router design:[[:space:]]*$|Data model and persistence:[[:space:]]*$|Security/auth/permission model:[[:space:]]*$|Microservice or monolith decision:[[:space:]]*$|Background jobs, integrations, and observability:[[:space:]]*$|Security/privacy assumptions:[[:space:]]*$|Dependency and SDK decisions:[[:space:]]*$|Error handling and recovery:[[:space:]]*$|Performance constraints:[[:space:]]*$|Test strategy and proof commands:[[:space:]]*$|Required: yes/no|Trigger reason:[[:space:]]*$|Review result:[[:space:]]*$|Required actions:[[:space:]]*$' "$path"
}

technical_steward_required_for_project() {
  local project="$1"
  load_project_schema "$project"
  [[ "$PROJECT_TYPE" == "api" || "$PROJECT_TYPE" == "agent" ]]
}

technical_plan_has_steward_approval() {
  local path="$1"
  grep -Eiq 'Required:[[:space:]]*yes' "$path" &&
    grep -Eiq 'Review result:[[:space:]]*(APPROVE|APPROVE_WITH_ACTIONS)' "$path"
}

technical_plan_has_steward_decision() {
  local path="$1"
  grep -Eiq 'Required:[[:space:]]*(yes|no)' "$path" &&
    grep -Eiq 'Trigger reason:[[:space:]]*.+' "$path" &&
    grep -Eiq 'Review result:[[:space:]]*(APPROVE|APPROVE_WITH_ACTIONS|n/a|N/A|NOT_REQUIRED)' "$path" &&
    grep -Eiq 'Required actions:[[:space:]]*.+' "$path"
}

check_technical_plan_coverage() {
  local dir="$1"
  local project="${2:-}"
  local path="$dir/tasks/TECHNICAL_PLAN.md"
  local failures=0
  require_content_file "$dir" "tasks/TECHNICAL_PLAN.md" || return 1
  if technical_plan_has_placeholder "$path"; then
    echo "Incomplete technical plan: replace template placeholders in tasks/TECHNICAL_PLAN.md." >&2
    failures=$((failures + 1))
  fi
  require_file_pattern "$dir" "tasks/TECHNICAL_PLAN.md" "technical plan: platform/language decision" 'Platform|Language|跨平台|开发语言|语言选型|Tech Stack|技术栈|平台' || failures=$((failures + 1))
  require_file_pattern "$dir" "tasks/TECHNICAL_PLAN.md" "technical plan: client architecture applicability" 'Client Architecture|客户端|Mobile|Native|iOS|Android|跨平台|MVVM' || failures=$((failures + 1))
  require_file_pattern "$dir" "tasks/TECHNICAL_PLAN.md" "technical plan: web frontend architecture applicability" 'Web Frontend Architecture|Web|前端|组件|Component|Router|路由' || failures=$((failures + 1))
  require_file_pattern "$dir" "tasks/TECHNICAL_PLAN.md" "technical plan: backend architecture applicability" 'Backend Architecture|Backend|后端|API|Microservice|微服务|Service|Router|路由|Security|安全' || failures=$((failures + 1))
  require_file_pattern "$dir" "tasks/TECHNICAL_PLAN.md" "technical plan: state/routing/component strategy" 'State|Routing|Router|状态管理|路由|Component|组件|MVVM|Store' || failures=$((failures + 1))
  require_file_pattern "$dir" "tasks/TECHNICAL_PLAN.md" "technical plan: security and quality" 'Security|Privacy|安全|隐私|权限|Auth|Test|Quality|质量' || failures=$((failures + 1))
  require_file_pattern "$dir" "tasks/TECHNICAL_PLAN.md" "technical plan: build slice and proof" 'Build Slice|Slice Plan|Proof|验证|Proof command|开发方案|实现计划' || failures=$((failures + 1))
  require_file_pattern "$dir" "tasks/TECHNICAL_PLAN.md" "technical plan: steward review decision" 'Technical Steward|technical-steward|steward|技术经理|review|Review' || failures=$((failures + 1))
  if ! technical_plan_has_build_slice_row "$path"; then
    echo "Incomplete technical plan: add at least one concrete Build Slice Plan row." >&2
    failures=$((failures + 1))
  fi
  if ! technical_plan_has_steward_decision "$path"; then
    echo "Incomplete technical plan: record an explicit Technical Steward Review decision." >&2
    failures=$((failures + 1))
  fi
  if [[ -n "$project" ]] && technical_steward_required_for_project "$project" && ! technical_plan_has_steward_approval "$path"; then
    echo "Missing required technical-steward approval in tasks/TECHNICAL_PLAN.md." >&2
    failures=$((failures + 1))
  fi
  [[ "$failures" -eq 0 ]]
}

require_any_file() {
  local dir="$1"
  local label="$2"
  shift 2
  local pattern
  for pattern in "$@"; do
    if find "$dir" -path "$dir/$pattern" -type f 2>/dev/null | grep -q .; then
      return 0
    fi
  done
  echo "Missing evidence: $label" >&2
  return 1
}

project_has_implemented_source() {
  local project="$1"
  local root rel dir
  root="$(project_path "$project")"
  for rel in package.json pyproject.toml Cargo.toml Package.swift go.mod pom.xml build.gradle build.gradle.kts settings.gradle settings.gradle.kts index.html; do
    [[ -f "$root/$rel" ]] && return 0
  done
  for dir in src app apps packages server lib public tests; do
    [[ -d "$root/$dir" ]] || continue
    if find "$root/$dir" -maxdepth 6 -type f 2>/dev/null | grep -q .; then
      return 0
    fi
  done
  return 1
}

visual_score() {
  local path="$1"
  [[ -f "$path" ]] || return 1
  sed -nE 's/.*Overall score:[[:space:]]*([0-9][0-9]?[0-9]?)\/100.*/\1/p' "$path" | head -n 1
}

qa_exception_recorded() {
  local dir="$1"
  [[ -f "$dir/reviews/EXCEPTION.md" || -f "$dir/reviews/BLOCKED_FLOW.md" ]]
}

verify_phase_impl() {
  local project="$1"
  local phase="$2"
  require_project "$project"
  if ! is_valid_phase "$phase"; then
    echo "Invalid phase: ${phase:-<missing>}" >&2
    return 1
  fi
  local dir source_root failures assets links mockups design_assets final_design_assets screenshots cut_assets cut_manifest_entries java_sources
  dir="$(project_process_root "$project")"
  source_root="$(project_path "$project")"
  failures=0
  case "$phase" in
    idea)
      require_content_file "$dir" "ideas/idea-brief.md" || failures=$((failures + 1))
      ;;
    spec)
      require_content_file "$dir" "product/PRD.md" || failures=$((failures + 1))
      require_content_file "$dir" "specs/SPEC.md" || failures=$((failures + 1))
      load_project_applicability "$project"
      if [[ "$PROJECT_TYPE" == "ui" ]] && [[ -f "$dir/product/PRD.md" && -f "$dir/specs/SPEC.md" ]]; then
        check_ui_spec_product_coverage "$dir" || failures=$((failures + 1))
      fi
      if agent_contract_applies "$project"; then
        if ! grep -Eq '^## +Agent Runtime Contract' "$dir/specs/SPEC.md"; then
          echo "Missing Agent Runtime Contract section in specs/SPEC.md for agent automation scope." >&2
          failures=$((failures + 1))
        fi
        if ! grep -Eiq 'tools?.*(permission|approval)|permission.*tools?' "$dir/specs/SPEC.md"; then
          echo "Missing tools/permissions boundary in specs/SPEC.md Agent Runtime Contract." >&2
          failures=$((failures + 1))
        fi
        if ! grep -Eiq 'failure|fallback|recovery|escalat' "$dir/specs/SPEC.md"; then
          echo "Missing failure recovery or escalation boundary in specs/SPEC.md Agent Runtime Contract." >&2
          failures=$((failures + 1))
        fi
      fi
      ;;
    design)
      assets="$(count_reference_assets "$dir")"
      links="$(count_reference_links "$dir")"
      mockups="$(count_design_mockups "$dir")"
      if references_required "$project" && [[ $((assets + links)) -eq 0 ]]; then
        echo "Missing references: add reference assets/software or reference links before design verification." >&2
        failures=$((failures + 1))
      fi
      load_project_applicability "$project"
      if setting_delegated "$UI_REFERENCES" && ! delegated_reference_board_present "$dir"; then
        echo "Missing delegated reference board: create design/REFERENCE_BOARD.md before using delegated visual direction." >&2
        failures=$((failures + 1))
      fi
      if ! check_design_asset_applicability_contract "$project"; then
        failures=$((failures + 1))
      elif design_assets_required "$project"; then
        asset_check_impl "$project" >/dev/null || failures=$((failures + 1))
      fi
      if setting_enabled "$UI_FIGMA_HANDOFF" || [[ "$(count_figma_design_artifact_rows "$dir")" -gt 0 ]]; then
        figma_check_impl "$project" >/dev/null || failures=$((failures + 1))
      fi
      if setting_enabled "$UI_MOCKUPS" && [[ "$mockups" -eq 0 ]]; then
        echo "Missing design mockups: add image/SVG/PDF/Figma artifacts under design/mocks/." >&2
        failures=$((failures + 1))
      fi
      for file in design/DESIGN.md design/VISUAL_SYSTEM.md design/SCREEN_ACCEPTANCE.md; do
        require_content_file "$dir" "$file" || failures=$((failures + 1))
      done
      if ! check_design_package_structure "$dir"; then
        failures=$((failures + 1))
      fi
      ;;
    build)
      if ! check_technical_plan_coverage "$dir" "$project"; then
        echo "Missing technical plan: add tasks/TECHNICAL_PLAN.md before implementation." >&2
        failures=$((failures + 1))
      fi
      if ! project_has_implemented_source "$project"; then
        echo "Missing evidence: implemented source under project root (src/, app/, apps/, packages/, or stack manifest files)." >&2
        failures=$((failures + 1))
      fi
      if [[ ! -f "$dir/reviews/VERIFICATION.md" && ! -f "$dir/reviews/BLOCKED_BUILD.md" ]]; then
        echo "Missing verification evidence: add reviews/VERIFICATION.md or reviews/BLOCKED_BUILD.md." >&2
        failures=$((failures + 1))
      fi
      if phase_is_applicable "$project" design; then
        require_content_file "$dir" "tasks/IMPLEMENTATION_TRACE.md" || failures=$((failures + 1))
        if [[ -f "$dir/tasks/IMPLEMENTATION_TRACE.md" ]]; then
          if design_assets_required "$project"; then
            check_implementation_trace_coverage "$dir" true || failures=$((failures + 1))
          else
            check_implementation_trace_coverage "$dir" false || failures=$((failures + 1))
          fi
        fi
      fi
      if [[ -d "$source_root/apps/android" ]]; then
        [[ -f "$source_root/apps/android/settings.gradle.kts" || -f "$source_root/apps/android/settings.gradle" ]] || { echo "Missing Android settings.gradle(.kts)." >&2; failures=$((failures + 1)); }
        [[ -f "$source_root/apps/android/app/build.gradle.kts" || -f "$source_root/apps/android/app/build.gradle" ]] || { echo "Missing Android app build.gradle(.kts)." >&2; failures=$((failures + 1)); }
        [[ -f "$source_root/apps/android/app/src/main/AndroidManifest.xml" ]] || { echo "Missing AndroidManifest.xml." >&2; failures=$((failures + 1)); }
        java_sources="$(find "$source_root/apps/android/app/src/main" -type f \( -name '*.java' -o -name '*.kt' \) 2>/dev/null | wc -l | tr -d ' ')"
        [[ "$java_sources" -gt 0 ]] || { echo "Missing Android Java/Kotlin sources." >&2; failures=$((failures + 1)); }
      fi
      ;;
    qa)
      if [[ -d "$source_root/apps/android" ]] && { ! command -v java >/dev/null 2>&1 || ! command -v gradle >/dev/null 2>&1; }; then
        require_content_file "$dir" "reviews/BLOCKED_BUILD.md" || failures=$((failures + 1))
      else
        if [[ ! -f "$dir/reviews/VERIFICATION.md" && ! -f "$dir/reviews/BLOCKED_BUILD.md" ]]; then
          echo "Missing verification evidence: add reviews/VERIFICATION.md or reviews/BLOCKED_BUILD.md." >&2
          failures=$((failures + 1))
        fi
      fi
      if qa_required "$project"; then
        if ! qa_check_impl "$project" >/dev/null; then
          failures=$((failures + 1))
        fi
      fi
      ;;
    ship)
      require_content_file "$dir" "ship/LAUNCH.md" || failures=$((failures + 1))
      ;;
  esac
  if [[ "$failures" -gt 0 ]]; then
    echo "Phase verification failed: $project/$phase" >&2
    return 1
  fi
  echo "Phase verification passed: $project/$phase"
}

qa_check_impl() {
  local project="$1"
  local dir failures mockups design_assets html_packages final_design_assets screenshots score cut_assets cut_manifest_entries
  require_project "$project"
  dir="$(project_process_root "$project")"
  failures=0
  mockups="$(count_design_mockups "$dir")"
  design_assets="$(count_approved_design_artifacts "$dir")"
  html_packages="$(count_approved_html_design_packages "$dir")"
  screenshots="$(( $(count_visual_screenshots "$dir") + $(count_acceptance_screenshots "$dir") ))"
  load_project_applicability "$project"
  if ! qa_required "$project"; then
    echo "QA check skipped for $project: AUTOMATED_QA=$AUTOMATED_QA, VISUAL_QA=$VISUAL_QA."
    return 0
  fi
  for file in reviews/VERIFICATION.md; do
    if ! has_content "$dir/$file"; then
      echo "Missing or too thin: $file" >&2
      failures=$((failures + 1))
    fi
  done
  if setting_enabled "$AUTOMATED_QA"; then
    for file in reviews/FUNCTIONAL_TEST.md reviews/MONKEY_TEST.md; do
      if ! has_content "$dir/$file"; then
        echo "Missing or too thin: $file" >&2
        failures=$((failures + 1))
      fi
    done
  fi
  if phase_is_applicable "$project" design && setting_enabled "$VISUAL_QA"; then
    for file in design/DESIGN.md design/VISUAL_SYSTEM.md design/SCREEN_ACCEPTANCE.md reviews/VISUAL_COMPARISON.md; do
      if ! has_content "$dir/$file"; then
        echo "Missing or too thin: $file" >&2
        failures=$((failures + 1))
      fi
    done
  fi
  if design_assets_required "$project"; then
    asset_check_impl "$project" >/dev/null || failures=$((failures + 1))
  fi
  if ! mobile_app_has_custom_icon_assets "$dir"; then
    echo "Missing custom mobile app icons: apps/mobile/assets/icon.png, adaptive-icon.png, and splash-icon.png must exist and not be Expo placeholders." >&2
    failures=$((failures + 1))
  fi
  if setting_enabled "$UI_MOCKUPS" && [[ "$mockups" -eq 0 ]]; then
    echo "Missing design mockup evidence under design/mocks/." >&2
    failures=$((failures + 1))
  fi
  score="$(visual_score "$dir/reviews/VISUAL_COMPARISON.md" || true)"
  if phase_is_applicable "$project" design && setting_enabled "$VISUAL_QA"; then
    if [[ -z "$score" ]]; then
      echo "Missing visual comparison score: add 'Overall score: N/100' to reviews/VISUAL_COMPARISON.md." >&2
      failures=$((failures + 1))
    elif [[ "$score" -gt 100 ]]; then
      echo "Visual comparison score out of range: $score/100." >&2
      failures=$((failures + 1))
    elif [[ "$score" -lt 90 ]]; then
      echo "Visual comparison score too low: $score/100, expected at least 90/100 for high-fidelity UI delivery." >&2
      failures=$((failures + 1))
    fi
    check_required_headings "$dir/reviews/VISUAL_COMPARISON.md" "reviews/VISUAL_COMPARISON.md" \
      "Compared Inputs" "Raster Calibration" "Screen Fidelity Matrix" "Score Breakdown" "Differences" "Decision" || failures=$((failures + 1))
    if ! check_visual_comparison_contract "$dir"; then
      failures=$((failures + 1))
    fi
  fi
  if qa_exception_recorded "$dir"; then
    if [[ "$screenshots" -eq 0 && ! -s "$dir/reviews/BLOCKED_SCREENSHOT.md" ]]; then
      echo "Exception or blocked-flow record found; add screenshot evidence under reviews/acceptance-screenshots/ or reviews/visual-screenshots/, or document why capture is impossible in reviews/BLOCKED_SCREENSHOT.md." >&2
      failures=$((failures + 1))
    fi
  fi
  if [[ "$failures" -gt 0 ]]; then
    echo "QA check failed for $project." >&2
    return 1
  fi
  echo "QA check passed for $project with automated QA=${AUTOMATED_QA}, visual QA=${VISUAL_QA}, approved visual assets=$design_assets, HTML/CSS companion packages=$html_packages, visual score ${score:-n/a}/100."
  if [[ "$screenshots" -eq 0 ]]; then
    echo "No exception or blocked flow recorded; runtime screenshots were not required."
  else
    echo "Runtime screenshot artifacts found: $screenshots."
  fi
}

env_status_is_positive() {
  case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in
    satisfied|installed|available|approved|ok|pass|passed|not-required|not\ required|not-needed|not\ needed|n/a|none) return 0 ;;
    *) return 1 ;;
  esac
}

env_status_is_blocked() {
  case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in
    ""|todo|tbd|unknown|missing|blocked|failed|fail|pending|needs-approval|needs\ approval|requires-approval|requires\ approval) return 0 ;;
    *) return 1 ;;
  esac
}

env_required_is_yes() {
  case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in
    yes|true|required|y) return 0 ;;
    *) return 1 ;;
  esac
}

env_check_impl() {
  local project="$1"
  local process_root path failures rows line capability scope required_by verify_cmd required permission status notes in_requirements display_root
  require_project "$project"
  process_root="$(project_process_root "$project")"
  display_root="$(project_process_display_root "$project")"
  path="$process_root/HOST_REQUIREMENTS.md"
  failures=0
  rows=0

  if [[ ! -f "$path" ]]; then
    echo "Missing host environment contract: $display_root/HOST_REQUIREMENTS.md" >&2
    echo "Run: bin/dev-flow migrate $project" >&2
    return 1
  fi

  if ! grep -Eq '^##[[:space:]]+Requirements' "$path"; then
    echo "Missing Requirements section in $display_root/HOST_REQUIREMENTS.md" >&2
    failures=$((failures + 1))
  fi

  in_requirements="false"
  while IFS= read -r line; do
    if [[ "$line" =~ ^##[[:space:]]+Requirements ]]; then
      in_requirements="true"
      continue
    fi
    if [[ "$line" =~ ^##[[:space:]]+ && "$in_requirements" == "true" ]]; then
      in_requirements="false"
    fi
    [[ "$in_requirements" == "true" ]] || continue
    [[ "$line" == \|* ]] || continue
    [[ "$line" =~ ^\|[[:space:]]*- ]] && continue
    IFS='|' read -r _ capability scope required_by verify_cmd required permission status notes _ <<< "$line"
    capability="$(trim_md_cell "$capability")"
    scope="$(trim_md_cell "$scope")"
    required_by="$(trim_md_cell "$required_by")"
    verify_cmd="$(trim_md_cell "$verify_cmd")"
    required="$(trim_md_cell "$required")"
    permission="$(trim_md_cell "$permission")"
    status="$(trim_md_cell "$status")"
    notes="$(trim_md_cell "$notes")"

    [[ -n "$capability" ]] || continue
    [[ "$(printf '%s' "$capability" | tr '[:upper:]' '[:lower:]')" == "capability" ]] && continue
    rows=$((rows + 1))

    if [[ "$(printf '%s' "$scope" | tr '[:upper:]' '[:lower:]')" == *work* || "$(printf '%s' "$scope" | tr '[:upper:]' '[:lower:]')" == project-runtime ]]; then
      echo "Invalid host requirement scope for $capability: host SDKs/CLIs must not be scoped to project runtime output." >&2
      failures=$((failures + 1))
    fi

    if env_status_is_blocked "$status"; then
      echo "Blocked host requirement: $capability (status: ${status:-missing}; required by: ${required_by:-unspecified})." >&2
      failures=$((failures + 1))
      continue
    fi

    if env_required_is_yes "$required"; then
      if [[ -z "$verify_cmd" || "$(printf '%s' "$verify_cmd" | tr '[:upper:]' '[:lower:]')" == "todo" || "$(printf '%s' "$verify_cmd" | tr '[:upper:]' '[:lower:]')" == "tbd" ]]; then
        echo "Missing verify command for required host capability: $capability" >&2
        failures=$((failures + 1))
      fi
      if ! env_status_is_positive "$status"; then
        echo "Required host capability is not satisfied: $capability (status: ${status:-missing})." >&2
        failures=$((failures + 1))
      fi
    fi
  done < "$path"

  if [[ "$rows" -eq 0 ]]; then
    echo "No host requirements table rows found in $display_root/HOST_REQUIREMENTS.md" >&2
    failures=$((failures + 1))
  fi

  if [[ "$failures" -gt 0 ]]; then
    echo "Host environment check failed for $project with $failures issue(s)." >&2
    return 1
  fi

  echo "Host environment check passed for $project. No host SDKs were installed by this command."
}

ship_check_impl() {
  local project="$1"
  local phase failures
  failures=0
  for phase in idea spec design build qa ship; do
    if [[ "$phase" != "ship" ]] && ! phase_is_applicable "$project" "$phase"; then
      echo "Skipping non-applicable phase: $project/$phase"
      continue
    fi
    if ! verify_phase_impl "$project" "$phase"; then
      failures=$((failures + 1))
    fi
  done
  if [[ "$failures" -gt 0 ]]; then
    echo "Ship check failed for $project with $failures failing phase(s)." >&2
    return 1
  fi
  if ! (cd "$(project_path "$project")" && "$(project_check_path "$project")"); then
    echo "Project default check failed for $project." >&2
    return 1
  fi
  if ! env_check_impl "$project"; then
    echo "Project host environment check failed for $project." >&2
    return 1
  fi
  if qa_required "$project"; then
    if ! qa_check_impl "$project"; then
      echo "Project QA check failed for $project." >&2
      return 1
    fi
  fi
  echo "Ship check passed for $project."
}

doctor_check_impl() {
  local project="$1"
  local dir control process_dir check_file failures schema_file tracked_runtime
  require_project "$project"
  dir="$(project_path "$project")"
  control="$(project_control_path "$project")"
  process_dir="$(project_process_root "$project")"
  check_file="$(project_check_path "$project")"
  schema_file="$(schema_path "$project")"
  failures=0
  if [[ ! -f "$schema_file" ]]; then
    echo "Missing schema: ${schema_file#"$dir"/}" >&2
    failures=$((failures + 1))
  else
    load_project_schema "$project"
    if [[ "$PROJECT_SCHEMA_VERSION" != "$DEV_FLOW_PROJECT_SCHEMA_VERSION" ]]; then
      echo "Outdated schema: PROJECT_SCHEMA_VERSION=$PROJECT_SCHEMA_VERSION, expected $DEV_FLOW_PROJECT_SCHEMA_VERSION" >&2
      failures=$((failures + 1))
    fi
    if ! dev_flow_valid_project_type "$PROJECT_TYPE"; then
      echo "Invalid schema project type: $PROJECT_TYPE" >&2
      failures=$((failures + 1))
    fi
  fi
  local dir_name
  local expected_dirs=("$control" "$process_dir")
  if [[ "$control" == "$dir/$NEW_CONTROL_DIR" ]]; then
    expected_dirs+=("$control/bin")
  else
    expected_dirs+=("$dir/bin")
  fi
  for dir_name in "${expected_dirs[@]}"; do
    if [[ ! -d "$dir_name" ]]; then
      case "$dir_name" in
        "$control") echo "Missing template directory: $(project_control_display_root "$project")" >&2 ;;
        "$control/bin") echo "Missing template directory: $(project_control_display_root "$project")/bin" >&2 ;;
        "$process_dir") echo "Missing template directory: $(project_process_display_root "$project")" >&2 ;;
        "$dir/bin") echo "Missing template directory: bin" >&2 ;;
      esac
      failures=$((failures + 1))
    fi
  done
  if [[ "$control" == "$dir/$NEW_CONTROL_DIR" && -d "$dir/$LEGACY_CONTROL_DIR" ]]; then
    echo "Legacy control directory still present: $LEGACY_CONTROL_DIR (run migrate after reviewing old files)" >&2
    failures=$((failures + 1))
  fi
  local file_name file_path
  for file_name in state/state.env state/applicability.env context.md HOST_REQUIREMENTS.md bin/check; do
    case "$file_name" in
      state/state.env) file_path="$(state_path "$project")" ;;
      state/applicability.env) file_path="$(applicability_path "$project")" ;;
      bin/check) file_path="$check_file" ;;
      *) file_path="$process_dir/$file_name" ;;
    esac
    if [[ ! -f "$file_path" ]]; then
      echo "Missing template file: ${file_path#"$dir"/}" >&2
      failures=$((failures + 1))
    fi
  done
  if [[ -f "$check_file" && ! -x "$check_file" ]]; then
    echo "Project check is not executable: ${check_file#"$dir"/}" >&2
    failures=$((failures + 1))
  fi
  tracked_runtime="$(git -C "$ROOT" ls-files "$project" "work/$project" "dist" ".codex" ".claude" ".gemini" ".openclaw" ".opencode" 2>/dev/null || true)"
  if [[ -n "$tracked_runtime" ]]; then
    echo "Tracked runtime/generated output found:" >&2
    printf '%s\n' "$tracked_runtime" >&2
    failures=$((failures + 1))
  fi
  if [[ "$failures" -gt 0 ]]; then
    echo "Doctor found $failures issue(s) for $project. Run: bin/dev-flow migrate $project" >&2
    return 1
  fi
  echo "Doctor passed for $project."
}

migrate_path_if_present() {
  local root="$1"
  local from_rel="$2"
  local to_rel="$3"
  local from="$root/$from_rel"
  local to="$root/$to_rel"
  [[ -e "$from" ]] || return 0
  if [[ -e "$to" ]]; then
    echo "Skipped existing migration target: $to_rel" >&2
    return 0
  fi
  mkdir -p "$(dirname "$to")"
  mv "$from" "$to"
}

migrate_legacy_layout_to_visible_process_root() {
  local root="$1"
  local process_root process_rel
  process_root="$(project_default_process_root_from_dir "$root")"
  process_rel="${process_root#"$root"/}"
  mkdir -p "$process_root/state" "$root/$NEW_CONTROL_DIR/bin"
  migrate_path_if_present "$root" "$LEGACY_CONTROL_DIR/state.env" "$process_rel/state/state.env"
  migrate_path_if_present "$root" "$LEGACY_CONTROL_DIR/schema.env" "$process_rel/state/schema.env"
  migrate_path_if_present "$root" "$LEGACY_CONTROL_DIR/applicability.env" "$process_rel/state/applicability.env"
  migrate_path_if_present "$root" "$LEGACY_CONTROL_DIR/autonomy.env" "$process_rel/state/autonomy.env"
  migrate_path_if_present "$root" "$LEGACY_CONTROL_DIR/context.md" "$process_rel/context.md"
  migrate_path_if_present "$root" "$LEGACY_CONTROL_DIR/HOST_REQUIREMENTS.md" "$process_rel/HOST_REQUIREMENTS.md"
  migrate_path_if_present "$root" "$NEW_CONTROL_DIR/state/state.env" "$process_rel/state/state.env"
  migrate_path_if_present "$root" "$NEW_CONTROL_DIR/state/schema.env" "$process_rel/state/schema.env"
  migrate_path_if_present "$root" "$NEW_CONTROL_DIR/state/applicability.env" "$process_rel/state/applicability.env"
  migrate_path_if_present "$root" "$NEW_CONTROL_DIR/state/autonomy.env" "$process_rel/state/autonomy.env"
  migrate_path_if_present "$root" "$NEW_CONTROL_DIR/context.md" "$process_rel/context.md"
  migrate_path_if_present "$root" "$NEW_CONTROL_DIR/HOST_REQUIREMENTS.md" "$process_rel/HOST_REQUIREMENTS.md"
  migrate_path_if_present "$root" "bin/check" "$NEW_CONTROL_DIR/bin/check"
  local rel
  for rel in ideas product specs agent design tasks reviews ship; do
    migrate_path_if_present "$root" "$rel" "$process_rel/$rel"
    migrate_path_if_present "$root" "$NEW_CONTROL_DIR/$rel" "$process_rel/$rel"
  done
  rmdir "$root/bin" "$root/$LEGACY_CONTROL_DIR" 2>/dev/null || true
  rmdir "$root/$NEW_CONTROL_DIR/state" "$root/$NEW_CONTROL_DIR" 2>/dev/null || true
}

migrate_project_impl() {
  local project="$1"
  local project_type="$2"
  local dir process_dir
  require_project "$project"
  dir="$(project_path "$project")"
  migrate_legacy_layout_to_visible_process_root "$dir"
  ensure_project_dirs "$dir"
  write_project_templates "$dir" "$project" "$project_type"
  write_project_schema_file "$project" "$project_type"
  load_project_state "$project"
  process_dir="$(project_process_root "$project")"
  ensure_phase_artifacts "$process_dir" "$project" "$project_type" "$CURRENT_PHASE"
  echo "Migrated $project to schema v$DEV_FLOW_PROJECT_SCHEMA_VERSION ($project_type)."
}

copy_runtime_package() {
  local target="$1"
  rm -rf "$target"
  mkdir -p "$target/bin" "$target/tests" "$target/dev-agent"
  cp "$ROOT/AGENTS.md" "$target/AGENTS.md"
  cp "$ROOT/DEV_FLOW.md" "$target/DEV_FLOW.md"
  cp "$ROOT/README.md" "$target/README.md"
  cp "$ROOT/LICENSE" "$target/LICENSE"
  cp "$PACK/dev-agent.manifest.json" "$target/dev-agent/dev-agent.manifest.json"
  cp "$ROOT/bin/dev-flow" "$target/bin/dev-flow"
  chmod +x "$target/bin/dev-flow"
  cp "$ROOT/tests/dev-flow-smoke.sh" "$target/tests/dev-flow-smoke.sh"
  chmod +x "$target/tests/dev-flow-smoke.sh"
  mkdir -p "$target/dev-agent/templates" "$target/dev-agent/lib"
  cp -R "$PACK/templates/." "$target/dev-agent/templates/"
  cp -R "$PACK/lib/." "$target/dev-agent/lib/"
  if [[ -d "$PACK/native" ]]; then
    mkdir -p "$target/dev-agent/native"
    cp -R "$PACK/native/." "$target/dev-agent/native/"
  fi
  for adapter_dir in .claude .gemini .claude-plugin; do
    if [[ -d "$PACK/$adapter_dir" ]]; then
      mkdir -p "$target/dev-agent/$adapter_dir"
      cp -R "$PACK/$adapter_dir/." "$target/dev-agent/$adapter_dir/"
    fi
  done
  copy_skill_dirs "$target/dev-agent/skills"
  copy_agent_dirs "$target/dev-agent/agents"
  copy_command_dirs "$target/dev-agent/commands"
  copy_reference_dirs "$target/dev-agent"
  clean_metadata "$target"
}

copy_skill_dirs() {
  local target="$1"
  local skill_dir
  local name
  mkdir -p "$target"
  if [[ -d "$PACK/skills" ]]; then
    for skill_dir in "$PACK/skills"/*; do
      [[ -d "$skill_dir" ]] || continue
      name="$(basename "$skill_dir")"
      mkdir -p "$target/$name"
      cp -R "$skill_dir/." "$target/$name/"
    done
  fi
}

copy_agent_dirs() {
  local target="$1"
  mkdir -p "$target"
  if [[ -d "$PACK/agents" ]]; then
    find "$PACK/agents" -mindepth 1 -maxdepth 1 -type f -name '*.md' -exec cp {} "$target" \;
  fi
}

copy_reference_dirs() {
  local target="$1"
  if [[ -d "$PACK/references" ]]; then
    mkdir -p "$target/references"
    cp -R "$PACK/references/." "$target/references/"
  fi
  if [[ -f "$PACK/dev-agent.manifest.json" ]]; then
    cp "$PACK/dev-agent.manifest.json" "$target/dev-agent.manifest.json"
  fi
}

copy_command_dirs() {
  local target="$1"
  mkdir -p "$target"
  if [[ -d "$PACK/commands" ]]; then
    cp -R "$PACK/commands/." "$target/"
  fi
}

copy_native_command_dirs() {
  local target="$1"
  mkdir -p "$target"
  [[ -f "$PACK/commands/dev.md" ]] && cp "$PACK/commands/dev.md" "$target/dev.md"
  [[ -f "$PACK/commands/dev-agent.md" ]] && cp "$PACK/commands/dev-agent.md" "$target/dev-agent.md"
}

copy_native_skill_dirs() {
  local target="$1"
  mkdir -p "$target"
  if [[ -d "$PACK/native/skills/dev-agent" ]]; then
    mkdir -p "$target/dev-agent"
    cp -R "$PACK/native/skills/dev-agent/." "$target/dev-agent/"
  fi
}

clean_metadata() {
  local target="$1"
  [[ -d "$target" ]] || return 0
  find "$target" \( -name '.DS_Store' -o -name '@eaDir' -o -name '*SynoEAStream' -o -name '*SynoResource' \) -prune -exec rm -rf {} + 2>/dev/null || true
}

copy_claude_commands() {
  local target="$1"
  mkdir -p "$target"
  if [[ -d "$PACK/.claude/commands" ]]; then
    cp -R "$PACK/.claude/commands/." "$target/"
  fi
}

copy_native_claude_commands() {
  local target="$1"
  mkdir -p "$target"
  [[ -f "$PACK/.claude/commands/dev.md" ]] && cp "$PACK/.claude/commands/dev.md" "$target/dev.md"
  [[ -f "$PACK/.claude/commands/dev-agent.md" ]] && cp "$PACK/.claude/commands/dev-agent.md" "$target/dev-agent.md"
}

copy_gemini_commands() {
  local target="$1"
  mkdir -p "$target"
  if [[ -d "$PACK/.gemini/commands" ]]; then
    cp -R "$PACK/.gemini/commands/." "$target/"
  fi
}

copy_native_gemini_commands() {
  local target="$1"
  mkdir -p "$target"
  [[ -f "$PACK/.gemini/commands/dev.toml" ]] && cp "$PACK/.gemini/commands/dev.toml" "$target/dev.toml"
  [[ -f "$PACK/.gemini/commands/dev-agent.toml" ]] && cp "$PACK/.gemini/commands/dev-agent.toml" "$target/dev-agent.toml"
}

embed_shared_references() {
  local skills_dir="$1"
  local skill_dir
  [[ -d "$skills_dir" && -d "$PACK/references" ]] || return 0
  for skill_dir in "$skills_dir"/*; do
    [[ -d "$skill_dir" ]] || continue
    mkdir -p "$skill_dir/references"
    cp -R "$PACK/references/." "$skill_dir/references/"
  done
}

skill_name() {
  case "${1:-}" in
    idea) echo "idea-refine" ;;
    spec) echo "spec-driven-development" ;;
    design) echo "design-flow" ;;
    build) echo "incremental-implementation" ;;
    qa) echo "frontend-ui-engineering" ;;
    debug) echo "debugging-and-error-recovery" ;;
    ui) echo "frontend-ui-engineering" ;;
    api) echo "api-and-interface-design" ;;
    security) echo "security-and-hardening" ;;
    ship) echo "shipping-and-launch" ;;
    *) echo "${1:-}" ;;
  esac
}

normalize_target() {
  case "${1:-}" in
    claude|claude-code) echo "claude-code" ;;
    codex|gemini|openclaw|opencode) echo "${1:-}" ;;
    *) echo "" ;;
  esac
}

default_install_dest() {
  local target="$1"
  local scope="$2"
  case "$scope:$target" in
    project:codex) echo "$ROOT/.codex" ;;
    user:codex) echo "${CODEX_HOME:-$HOME/.codex}" ;;
    project:claude-code) echo "$ROOT/.claude" ;;
    user:claude-code) echo "$HOME/.claude" ;;
    project:gemini) echo "$ROOT/.gemini/extensions/dev-flow-quality" ;;
    user:gemini) echo "$HOME/.gemini/extensions/dev-flow-quality" ;;
    project:openclaw) echo "$ROOT/.openclaw" ;;
    user:openclaw) echo "$HOME/.openclaw" ;;
    project:opencode) echo "$ROOT/.opencode" ;;
    user:opencode) echo "$HOME/.config/opencode" ;;
    *) return 1 ;;
  esac
}

write_gemini_extension_manifest() {
  local target="$1"
  cat > "$target/gemini-extension.json" <<'EOF'
{
  "name": "dev-flow-quality",
  "version": "0.1.0",
  "description": "Agent skills and personas for lifecycle-driven software delivery",
  "contextFileName": "GEMINI.md",
  "plan": {
    "directory": ".gemini/plans"
  }
}
EOF
  cat > "$target/GEMINI.md" <<'EOF'
# Dev Flow Quality

Use the bundled skills for lifecycle-driven software delivery. For customer-facing UI, design-flow owns reference intake and screen acceptance; frontend-ui-engineering owns implementation, acceptance QA, monkey testing, and visual comparison.
EOF
}

install_adapter() {
  local target_raw="${1:-}"
  local target
  target="$(normalize_target "$target_raw")"
  if [[ -z "$target" ]]; then
    echo "Unknown install target: ${target_raw:-<missing>}" >&2
    echo "Targets: codex, claude-code, gemini, openclaw, opencode" >&2
    exit 1
  fi

  local scope="project"
  local dest=""
  local mode="native"
  shift || true
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --scope)
        scope="${2:-}"
        shift 2
        ;;
      --scope=*)
        scope="${1#--scope=}"
        shift
        ;;
      --dest)
        dest="${2:-}"
        shift 2
        ;;
      --dest=*)
        dest="${1#--dest=}"
        shift
        ;;
      --mode)
        mode="${2:-}"
        shift 2
        ;;
      --mode=*)
        mode="${1#--mode=}"
        shift
        ;;
      *)
        echo "Unknown install option: $1" >&2
        usage >&2
        exit 1
        ;;
    esac
  done

  if [[ "$scope" != "project" && "$scope" != "user" ]]; then
    echo "Invalid scope: $scope" >&2
    echo "Use --scope project or --scope user." >&2
    exit 1
  fi
  if [[ "$mode" != "native" && "$mode" != "full" ]]; then
    echo "Invalid install mode: $mode" >&2
    echo "Use --mode native or --mode full." >&2
    exit 1
  fi
  if [[ -z "$dest" ]]; then
    dest="$(default_install_dest "$target" "$scope")"
  fi

  case "$target" in
    codex)
      if [[ "$mode" == "full" ]]; then
        copy_skill_dirs "$dest/skills"
        copy_agent_dirs "$dest/agents"
        copy_reference_dirs "$dest"
        copy_command_dirs "$dest/commands"
        embed_shared_references "$dest/skills"
      else
        copy_native_skill_dirs "$dest/skills"
        copy_native_command_dirs "$dest/commands"
      fi
      ;;
    claude-code)
      if [[ "$mode" == "full" ]]; then
        copy_skill_dirs "$dest/skills"
        copy_agent_dirs "$dest/agents"
        copy_reference_dirs "$dest"
        copy_claude_commands "$dest/commands"
        embed_shared_references "$dest/skills"
      else
        copy_native_skill_dirs "$dest/skills"
        copy_native_claude_commands "$dest/commands"
      fi
      ;;
    gemini)
      mkdir -p "$dest"
      if [[ "$mode" == "full" ]]; then
        copy_skill_dirs "$dest/skills"
        copy_agent_dirs "$dest/agents"
        copy_reference_dirs "$dest"
        copy_gemini_commands "$dest/commands"
        embed_shared_references "$dest/skills"
      else
        copy_native_skill_dirs "$dest/skills"
        copy_native_gemini_commands "$dest/commands"
      fi
      write_gemini_extension_manifest "$dest"
      ;;
    openclaw)
      if [[ "$mode" == "full" ]]; then
        copy_skill_dirs "$dest/skills"
        copy_agent_dirs "$dest/agents"
        copy_reference_dirs "$dest"
        copy_command_dirs "$dest/commands"
        embed_shared_references "$dest/skills"
      else
        copy_native_skill_dirs "$dest/skills"
        copy_native_command_dirs "$dest/commands"
      fi
      ;;
    opencode)
      if [[ "$mode" == "full" ]]; then
        copy_skill_dirs "$dest/skills"
        copy_agent_dirs "$dest/agents"
        copy_reference_dirs "$dest"
        copy_command_dirs "$dest/commands"
        embed_shared_references "$dest/skills"
      else
        copy_native_skill_dirs "$dest/skills"
        copy_native_command_dirs "$dest/commands"
      fi
      ;;
  esac

  remove_legacy_native_files "$dest"
  copy_runtime_package "$dest/dev-agent-runtime"
  clean_metadata "$dest"
  echo "Installed $target adapter under $dest"
  echo "Scope: $scope"
  echo "Mode: $mode"
  echo "Runtime: $dest/dev-agent-runtime"
}

remove_installed_path() {
  local path="$1"
  if [[ -e "$path" ]]; then
    rm -rf "$path"
    echo "Removed $path"
  fi
}

remove_legacy_native_files() {
  local target="$1"
  local name
  for name in opc-flow opc-role opc-next opc-check dev-flow dev-role dev-next dev-check pm agent test review; do
    remove_installed_path "$target/commands/$name.md"
    remove_installed_path "$target/commands/$name.toml"
  done
  remove_installed_path "$target/skills/dev-agent-opc"
  remove_installed_path "$target/dev-agent-opc.manifest.json"
  remove_installed_path "$target/dev-agent-opc-runtime"
}

remove_matching_file() {
  local source="$1"
  local target="$2"
  if [[ ! -e "$target" ]]; then
    return 0
  fi
  if [[ -f "$source" && -f "$target" ]] && cmp -s "$source" "$target"; then
    rm -f "$target"
    echo "Removed $target"
  else
    echo "Skipped modified or unknown file: $target" >&2
  fi
}

remove_matching_dir_by_skill() {
  local source_dir="$1"
  local target_dir="$2"
  if [[ ! -d "$target_dir" ]]; then
    return 0
  fi
  if [[ -f "$source_dir/SKILL.md" && -f "$target_dir/SKILL.md" ]] && cmp -s "$source_dir/SKILL.md" "$target_dir/SKILL.md"; then
    rm -rf "$target_dir"
    echo "Removed $target_dir"
  else
    echo "Skipped modified or unknown skill dir: $target_dir" >&2
  fi
}

remove_dev_flow_files() {
  local target="$1"
  local command_source="$2"
  local command_ext="$3"
  local file
  local name

  if [[ -d "$PACK/skills" ]]; then
    for file in "$PACK/skills"/*; do
      [[ -d "$file" ]] || continue
      name="$(basename "$file")"
      remove_matching_dir_by_skill "$file" "$target/skills/$name"
    done
  fi
  remove_matching_dir_by_skill "$PACK/native/skills/dev-agent" "$target/skills/dev-agent"
  remove_legacy_native_files "$target"

  if [[ -d "$command_source" ]]; then
    for file in "$command_source"/*."$command_ext"; do
      [[ -f "$file" ]] || continue
      remove_matching_file "$file" "$target/commands/$(basename "$file")"
    done
  fi

  if [[ -d "$PACK/agents" ]]; then
    for file in "$PACK/agents"/*.md; do
      [[ -f "$file" ]] || continue
      remove_matching_file "$file" "$target/agents/$(basename "$file")"
    done
  fi

  if [[ -d "$PACK/references" ]]; then
    for file in "$PACK/references"/*.md; do
      [[ -f "$file" ]] || continue
      remove_matching_file "$file" "$target/references/$(basename "$file")"
    done
  fi
  remove_matching_file "$PACK/dev-agent.manifest.json" "$target/dev-agent.manifest.json"
  remove_installed_path "$target/dev-agent-runtime"
  remove_installed_path "$target/dev-agent-opc-runtime"
  rmdir "$target/skills" "$target/commands" "$target/agents" "$target/references" 2>/dev/null || true
}

uninstall_adapter() {
  local target_raw="${1:-}"
  local target
  target="$(normalize_target "$target_raw")"
  if [[ -z "$target" ]]; then
    echo "Unknown uninstall target: ${target_raw:-<missing>}" >&2
    echo "Targets: codex, claude-code, gemini, openclaw, opencode" >&2
    exit 1
  fi

  local scope="project"
  local dest=""
  shift || true
  while [[ "$#" -gt 0 ]]; do
    case "$1" in
      --scope)
        scope="${2:-}"
        shift 2
        ;;
      --scope=*)
        scope="${1#--scope=}"
        shift
        ;;
      --dest)
        dest="${2:-}"
        shift 2
        ;;
      --dest=*)
        dest="${1#--dest=}"
        shift
        ;;
      *)
        echo "Unknown uninstall option: $1" >&2
        usage >&2
        exit 1
        ;;
    esac
  done

  if [[ "$scope" != "project" && "$scope" != "user" ]]; then
    echo "Invalid scope: $scope" >&2
    echo "Use --scope project or --scope user." >&2
    exit 1
  fi
  if [[ -z "$dest" ]]; then
    dest="$(default_install_dest "$target" "$scope")"
  fi

  case "$target" in
    claude-code)
      remove_dev_flow_files "$dest" "$PACK/.claude/commands" "md"
      ;;
    gemini)
      remove_dev_flow_files "$dest" "$PACK/.gemini/commands" "toml"
      remove_matching_file <(printf '%s\n' '{"name":"dev-flow-quality"}') "$dest/gemini-extension.json"
      ;;
    codex|openclaw|opencode)
      remove_dev_flow_files "$dest" "$PACK/commands" "md"
      ;;
  esac

  echo "Uninstalled $target adapter from $dest"
}

skill_path() {
  local name
  name="$(skill_name "${1:-}")"
  echo "$PACK/skills/$name/SKILL.md"
}

persona_name() {
  case "${1:-}" in
    opc-code-reviewer) echo "code-reviewer" ;;
    opc-product-designer) echo "product-designer" ;;
    opc-security-auditor) echo "security-auditor" ;;
    opc-technical-steward) echo "technical-steward" ;;
    opc-test-engineer) echo "test-engineer" ;;
    opc-ui-quality-reviewer) echo "ui-quality-reviewer" ;;
    *) echo "${1:-}" ;;
  esac
}

persona_path() {
  local name
  name="$(persona_name "${1:-}")"
  echo "$PACK/agents/$name.md"
}

require_pack() {
  if [[ ! -d "$PACK" ]]; then
    echo "Missing $PACK. Restore the canonical dev-agent/ directory before running dev-flow." >&2
    exit 1
  fi
  if [[ ! -d "$TEMPLATES" ]]; then
    echo "Missing $TEMPLATES. Restore dev-agent/templates/project before running dev-flow." >&2
    exit 1
  fi
  if [[ ! -d "$LIB" ]] || ! command -v dev_flow_valid_project_type >/dev/null 2>&1 || ! command -v dev_flow_write_template_if_missing >/dev/null 2>&1; then
    echo "Missing dev-flow library modules under $LIB." >&2
    exit 1
  fi
}

cmd="${1:-help}"
require_pack

case "$cmd" in
  list)
    find "$PACK/skills" -mindepth 2 -maxdepth 2 -name SKILL.md \
      | sed "s#^$PACK/skills/##; s#/SKILL.md\$##" \
      | sort -u
    ;;
  manifest)
    path="$PACK/dev-agent.manifest.json"
    if [[ ! -f "$path" ]]; then
      echo "Missing manifest: $path" >&2
      exit 1
    fi
    cat "$path"
    ;;
  show)
    path="$(skill_path "${2:-}")"
    if [[ -z "${2:-}" || ! -f "$path" ]]; then
      echo "Unknown skill or alias: ${2:-<missing>}" >&2
      usage >&2
      exit 1
    fi
    cat "$path"
    ;;
  path)
    path="$(skill_path "${2:-}")"
    if [[ -z "${2:-}" || ! -f "$path" ]]; then
      echo "Unknown skill or alias: ${2:-<missing>}" >&2
      usage >&2
      exit 1
    fi
    echo "$path"
    ;;
  command)
    name="${2:-}"
    path="$PACK/commands/$name.md"
    if [[ -z "$name" || ! -f "$path" ]]; then
      echo "Unknown command: ${name:-<missing>}" >&2
      usage >&2
      exit 1
    fi
    cat "$path"
    ;;
  agent)
    name="${2:-}"
    path="$(persona_path "$name")"
    if [[ -z "$name" || ! -f "$path" ]]; then
      echo "Unknown agent persona: ${name:-<missing>}" >&2
      usage >&2
      exit 1
    fi
    cat "$path"
    ;;
  install)
    install_adapter "${2:-}" "${@:3}"
    ;;
  uninstall)
    uninstall_adapter "${2:-}" "${@:3}"
    ;;
  refs)
    find "$PACK/references" -maxdepth 1 -type f -name '*.md' | sort
    ;;
  init)
    project="${2:-}"
    shift 2 || true
    project_type="$(project_type_from_options "$@")"
    dir="$(project_path "$project")"
    ensure_project_dirs "$dir"
    write_project_templates "$dir" "$project" "$project_type"
    echo "Initialized $dir"
    echo "Next: bin/dev-flow next $project"
    ;;
  status)
    project="${2:-}"
    require_project "$project"
    dir="$(project_path "$project")"
    load_project_state "$project"
    echo "Project: $project"
    echo "Path: $dir"
    echo "Phase: $CURRENT_PHASE"
    echo "Current task: $CURRENT_TASK"
    echo "Blockers: $BLOCKERS"
    echo "Last verification: $LAST_VERIFICATION"
    echo
    echo "Artifacts:"
    find "$dir" -maxdepth 4 -type f \
      | sed "s#^$dir/##" \
      | sort
    ;;
  phase)
    project="${2:-}"
    phase="${3:-}"
    task=""
    force="false"
    shift 3 || true
    while [[ "$#" -gt 0 ]]; do
      case "$1" in
        --force) force="true"; shift ;;
        *)
          if [[ -z "$task" ]]; then task="$1"; else task="$task $1"; fi
          shift
          ;;
      esac
    done
    require_project "$project"
    ensure_control_for_uninitialized_project "$project"
    if ! is_valid_phase "$phase"; then
      echo "Invalid phase: ${phase:-<missing>}" >&2
      echo "Valid phases: idea, spec, design, build, qa, ship" >&2
      exit 1
    fi
    if [[ "$phase" == "ship" ]]; then
      set_project_applicability "$project" "SHIP_FLOW" "required"
    fi
    if [[ "$force" != "true" ]]; then
      verify_prior_applicable_phases "$project" "$phase"
    fi
    load_project_state "$project"
    load_project_schema "$project"
    if [[ -z "$task" ]]; then
      task="$CURRENT_TASK"
    fi
    write_project_state "$project" "$phase" "$task" "$BLOCKERS" "$LAST_VERIFICATION"
    dir="$(project_process_root "$project")"
    ensure_phase_artifacts "$dir" "$project" "$PROJECT_TYPE" "$phase"
    ensure_status_artifacts "$dir" "$project" "$PROJECT_TYPE"
    {
      echo
      echo "## Update $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
      echo "- Phase: $phase"
      echo "- Current task: $task"
    } >> "$dir/tasks/status.md"
    echo "Updated $project to phase: $phase"
    echo "Next: bin/dev-flow next $project"
    ;;
  next)
    project="${2:-}"
    brief_mode="${3:---brief}"
    require_project "$project"
    ensure_control_for_uninitialized_project "$project"
    load_project_state "$project"
    load_project_schema "$project"
    dir="$(project_process_root "$project")"
    ensure_phase_artifacts "$dir" "$project" "$PROJECT_TYPE" "$CURRENT_PHASE"
    echo "Project: $project"
    echo "Type: $PROJECT_TYPE"
    echo "Current phase: $CURRENT_PHASE"
    echo "Current task: $CURRENT_TASK"
    echo "Blockers: $BLOCKERS"
    echo
    case "$brief_mode" in
      --brief|brief)
        next_brief_for_phase "$project" "$CURRENT_PHASE"
        ;;
      --phase-brief|phase|phase-brief)
        next_prompt_for_phase "$project" "$CURRENT_PHASE"
        ;;
      --full|full)
        next_full_prompt_for_phase "$project" "$CURRENT_PHASE"
        ;;
      *)
        echo "Unknown next brief mode: $brief_mode" >&2
        echo "Use --brief, --phase-brief, or --full." >&2
        exit 1
        ;;
    esac
    ;;
  plan)
    project="${2:-}"
    plan_task_queue_impl "$project"
    ;;
  task)
    project="${2:-}"
    action="${3:-}"
    task_id="${4:-}"
    shift 4 || true
    reason="$*"
    case "$action" in
      next)
        task_next_impl "$project"
        ;;
      start)
        task_update_status_impl "$project" "$task_id" "in_progress"
        ;;
      done)
        task_update_status_impl "$project" "$task_id" "done"
        ;;
      block)
        task_update_status_impl "$project" "$task_id" "blocked" "$reason"
        ;;
      *)
        echo "Unknown task action: ${action:-<missing>}" >&2
        echo "Use: bin/dev-flow task <project> <next|start|done|block> [task-id] [reason]" >&2
        exit 1
        ;;
    esac
    ;;
  verify-phase)
    project="${2:-}"
    phase="${3:-}"
    verify_phase_impl "$project" "$phase"
    record_verification "$project" "verify-phase:$phase passed at $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    ;;
  ship-check)
    project="${2:-}"
    ship_check_impl "$project"
    record_verification "$project" "ship-check passed at $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    ;;
  env-check)
    project="${2:-}"
    env_check_impl "$project"
    record_verification "$project" "env-check passed at $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    ;;
  doctor)
    project="${2:-}"
    doctor_check_impl "$project"
    ;;
  migrate)
    project="${2:-}"
    shift 2 || true
    project_type="$(project_type_from_options "$@")"
    migrate_project_impl "$project" "$project_type"
    ;;
  autonomy)
    project="${2:-}"
    require_project "$project"
    load_project_state "$project"
    autonomy_decision_for_phase "$project" "$CURRENT_PHASE"
    ;;
  delegate)
    project="${2:-}"
    require_project "$project"
    load_project_state "$project"
    delegation_recommendation_for_phase "$project" "$CURRENT_PHASE"
    ;;
  ui-polish)
    project="${2:-}"
    record_ui_polish_pass_impl "$project"
    ;;
  reference-check)
    project="${2:-}"
    mode="${3:-}"
    require_project "$project"
    dir="$(project_process_root "$project")"
    load_project_applicability "$project"
    if [[ "$mode" == "--delegated" ]]; then
      set_project_applicability "$project" "UI_REFERENCES" "delegated"
      UI_REFERENCES="delegated"
    fi
    assets="$(count_reference_assets "$dir")"
    links="$(count_reference_links "$dir")"
    total=$((assets + links))
    echo "Project: $project"
    echo "Reference assets: $assets"
    echo "Reference links/software notes: $links"
    if ! references_required_loaded; then
      echo "Reference intake passed by project applicability: UI_REFERENCES=$UI_REFERENCES."
      echo "Record the delegated visual direction in DESIGN.md and approve formal design assets before implementation."
      exit 0
    fi
    if [[ "$total" -gt 0 ]]; then
      echo "Reference intake passed."
      echo "Use these references in design requirements and visual comparison QA."
      exit 0
    fi
    echo "No reference assets or reference software found."
    echo "For customer-facing UI, ask the user for reference images, screenshots, Figma links, app names, or websites before design."
    echo "If the user delegates visual direction, create a reference board under $(project_process_display_root "$project")/design/ before UI build."
    if [[ "$mode" == "--required" ]]; then
      exit 1
    fi
    ;;
  asset-check)
    project="${2:-}"
    asset_check_impl "$project"
    record_verification "$project" "asset-check passed at $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    ;;
  figma-check)
    project="${2:-}"
    figma_check_impl "$project"
    record_verification "$project" "figma-check passed at $(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    ;;
  design-check)
    project="${2:-}"
    mode="${3:-}"
    require_project "$project"
    dir="$(project_process_root "$project")"
    failures=0
    design_assets="$(count_approved_design_artifacts "$dir")"
    html_packages="$(count_approved_html_design_packages "$dir")"
    final_design_assets="$(count_final_design_artifacts "$dir")"
    load_project_applicability "$project"
    if [[ "$mode" == "--allow-no-reference" ]]; then
      set_project_applicability "$project" "UI_REFERENCES" "delegated"
      UI_REFERENCES="delegated"
    fi
    if references_required_loaded; then
      assets="$(count_reference_assets "$dir")"
      links="$(count_reference_links "$dir")"
      if [[ $((assets + links)) -eq 0 ]]; then
        echo "Missing references: add reference assets/software or set UI_REFERENCES=\"delegated\" after the user explicitly delegates visual direction." >&2
        failures=$((failures + 1))
      fi
    fi
    if setting_delegated "$UI_REFERENCES" && ! delegated_reference_board_present "$dir"; then
      echo "Missing delegated reference board: create design/REFERENCE_BOARD.md before using delegated visual direction." >&2
      failures=$((failures + 1))
    fi
    if ! check_design_asset_applicability_contract "$project"; then
      failures=$((failures + 1))
    elif design_assets_required "$project"; then
      asset_check_impl "$project" >/dev/null || failures=$((failures + 1))
    fi
    if setting_enabled "$UI_FIGMA_HANDOFF" || [[ "$(count_figma_design_artifact_rows "$dir")" -gt 0 ]]; then
      figma_check_impl "$project" >/dev/null || failures=$((failures + 1))
    fi
    for file in design/DESIGN.md design/VISUAL_SYSTEM.md design/SCREEN_ACCEPTANCE.md; do
      if ! has_content "$dir/$file"; then
        echo "Missing or too thin: $file" >&2
        failures=$((failures + 1))
      fi
    done
    if ! check_design_package_structure "$dir"; then
      failures=$((failures + 1))
    fi
    if [[ "$failures" -gt 0 ]]; then
      echo "Design check failed for $project." >&2
      exit 1
    fi
    if design_assets_required "$project"; then
      echo "Design check passed for $project with $design_assets approved visual asset(s) and $html_packages approved HTML/CSS design package(s), covering every SCREEN_ACCEPTANCE screen."
    else
      echo "Design check passed for $project with non-UI/code-only design acceptance; formal approved assets are not required because UI_FLOW is disabled or design is not applicable."
    fi
    ;;
  qa-check|visual-check)
    project="${2:-}"
    qa_check_impl "$project"
    ;;
  check)
    project="${2:-}"
    require_project "$project"
    dir="$(project_path "$project")"
    check_file="$(project_check_path "$project")"
    if [[ ! -x "$check_file" ]]; then
      echo "Missing executable quality gate: $check_file" >&2
      exit 1
    fi
    (cd "$dir" && "$check_file")
    ;;
  package-adapters)
    out="${2:-dist/dev-flow-native}"
    if [[ -e "$out" ]]; then
      echo "Output already exists: $out" >&2
      echo "Choose a new output directory." >&2
      exit 1
    fi
    mkdir -p "$out"

    copy_skill_dirs "$out/codex/skills"
    copy_agent_dirs "$out/codex/agents"
    copy_reference_dirs "$out/codex"
    copy_command_dirs "$out/codex/commands"
    embed_shared_references "$out/codex/skills"

    copy_skill_dirs "$out/claude-code/skills"
    copy_agent_dirs "$out/claude-code/agents"
    copy_reference_dirs "$out/claude-code"
    embed_shared_references "$out/claude-code/skills"
    copy_claude_commands "$out/claude-code/.claude/commands"

    mkdir -p "$out/gemini/dev-flow-quality"
    copy_skill_dirs "$out/gemini/dev-flow-quality/skills"
    copy_agent_dirs "$out/gemini/dev-flow-quality/agents"
    copy_reference_dirs "$out/gemini/dev-flow-quality"
    embed_shared_references "$out/gemini/dev-flow-quality/skills"
    copy_gemini_commands "$out/gemini/dev-flow-quality/commands"
    write_gemini_extension_manifest "$out/gemini/dev-flow-quality"

    copy_skill_dirs "$out/openclaw/skills"
    copy_agent_dirs "$out/openclaw/agents"
    copy_reference_dirs "$out/openclaw"
    copy_command_dirs "$out/openclaw/commands"
    embed_shared_references "$out/openclaw/skills"

    copy_skill_dirs "$out/opencode/.opencode/skills"
    copy_agent_dirs "$out/opencode/.opencode/agents"
    copy_reference_dirs "$out/opencode/.opencode"
    copy_command_dirs "$out/opencode/.opencode/commands"
    embed_shared_references "$out/opencode/.opencode/skills"

    copy_runtime_package "$out/runtime"

    cat > "$out/INSTALL.md" <<'EOF'
# Dev Agent Native Adapter Package

Install the generated folders into the target agent surface. There are two layers:

- Rules prompt layer: install `skills/`, `commands/`, `agents/`, and `references/` into the target agent host.
- Runtime gate layer: use `runtime/` when you also need executable `bin/dev-flow` gates, project templates, `doctor`, `migrate`, `env-check`, `asset-check`, smoke tests, and adapter packaging.

- Codex App/CLI: copy `codex/skills/*` to `~/.codex/skills/`. `codex/commands/` contains reusable prompt shortcuts for hosts that support custom commands or snippets.
- Claude Code: copy `claude-code/skills/*` to `~/.claude/skills/` or project `.claude/skills/`; copy `.claude/commands/` into a project when slash commands are desired.
- Claude.ai/API: upload or package each skill folder separately for that surface.
- Gemini CLI: run `gemini extensions link <path-to>/gemini/dev-flow-quality` while developing, or `gemini extensions install <path-to>/gemini/dev-flow-quality`.
- OpenClaw: copy `openclaw/skills/*` to `~/.openclaw/skills/`, `~/.agents/skills/`, or workspace `skills/`; use `openclaw/commands/` as command snippets where supported.
- OpenCode: copy `opencode/.opencode/skills/*` into a workspace `.opencode/skills/`, or copy to `~/.config/opencode/skills/`; copy `.opencode/commands/` where supported.

Agent personas are included under each adapter's `agents/` directory when the platform supports persona/sub-agent files. Shared references are embedded into each packaged skill so standalone skill installation keeps reference files available.

The `runtime/` folder is a self-contained workflow-pack checkout surface. Copy or clone it when a platform user needs the same machine-checkable gates used by this repository. It intentionally excludes project runtime folders, checked-in `dist/`, local host adapter installs, and host-level SDKs. Host SDKs and permissions belong in each project's `dev-agent/HOST_REQUIREMENTS.md` contract, not inside the project runtime folder.

The helper can also install directly:

```bash
bin/dev-flow install codex --scope user
bin/dev-flow install claude-code --scope project
bin/dev-flow install gemini --scope project
bin/dev-flow install openclaw --scope user
bin/dev-flow install opencode --scope project
```

Direct installs default to native mode: one `dev-agent` top-level skill, `/dev agent`
plus `/dev-agent` commands, and a `dev-agent-runtime/` folder under the destination.
Use `--mode full` to install every internal workflow skill as a top-level skill.
Uninstall with `bin/dev-flow uninstall <target> --scope <project|user>`.
EOF
